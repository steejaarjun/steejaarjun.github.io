---
import { Picture } from 'astro:assets';
import { AVOID, GROUPS } from '../data/dresscode';
/* The shoe detail, as a print laid beside the dress code. It was briefly a
   full-bleed band above this section; a band that shallow read as a divider
   rather than as a photograph, and the shoes belong next to the clothes. It
   appears here and nowhere else — it is deliberately absent from gallery.ts. */
import shoePhoto from '../assets/photos/gallery/EPK03357.jpg';
/* Derived 1920px master, not the original — see prepare-media.mjs.

   The tilted frame against the yellow wall, and it is the right ground for this
   particular section rather than just a brighter picture: the wall is the warm
   ochre the palette is built from, and Steeja's red gingham is the peach the
   section is asking everyone else to wear. The section illustrates its own
   instruction.

   It replaces the near-black embrace frame, which is exposed for one lamp and
   read as an empty rectangle wherever it was put. That one now appears only in
   the film strip, on ink, surrounded by its own tonal range.

   The words never touch the photograph in either case: they are ink on shell
   inside the bubble, at the same contrast as every other heading on the site. */
import headerPhoto from '../assets/photos/gallery/EPW09924.jpg';

/* The little drawn flower at the corner of the print below. Shared with
   Story.astro, which pins its photograph with the same mark at the opposite
   corner — one file so it stays one drawing. It carries no position of its own;
   see the note in there for why the placing is left to us. */
import PinFlower from './PinFlower.astro';

/**
 * Flat, single-weight line silhouettes on a 240x320 canvas. Drawn here rather
 * than pulled from an icon set so the line weight and proportions match the
 * rest of the page; they scale fluidly with the panel.
 */
const ILLUSTRATION: Record<string, { alt: string; paths: string[] }> = {
  ladies: {
    alt: 'Line drawing of a long gown',
    paths: [
      // Bodice, then an A-line skirt to the floor.
      'M98 78C106 70 134 70 142 78L138 148L186 282C150 296 90 296 54 282L102 148Z',
      'M104 78L99 52', // shoulder straps, splaying out rather than meeting
      'M136 78L141 52',
      'M102 148H138', // waist seam
    ],
  },
  aunties: {
    alt: 'Line drawing of a draped saree',
    paths: [
      // One draped garment from bust to floor rather than a separate blouse —
      // a second outline there reads as a box the pallu crosses, not a drape.
      'M100 80C110 74 130 74 140 80L146 126L176 286C140 297 100 297 64 286L94 126Z',
      'M94 126H146', // waist
      // Pallu: a ribbon from the left shoulder, across the body, falling right.
      'M102 80C108 106 126 130 150 148C157 189 161 240 165 288L147 290C143 242 139 194 131 160C111 144 94 118 89 86Z',
      'M120 132L118 290', // pleats
    ],
  },
  gentlemen: {
    alt: 'Line drawing of a two-piece suit',
    paths: [
      // Jacket, cut away to a V at the top button.
      'M82 76C88 64 96 58 106 58L120 104L134 58C144 58 152 64 158 76L152 190H88Z',
      // Shirt showing through the V.
      'M108 60L120 100L132 60Z',
      'M106 58L96 92', // lapel edges
      'M134 58L144 92',
      'M120 104V190', // jacket opening below the button
      // Trousers.
      'M88 190L84 296H110L119 218L128 296H154L150 190Z',
    ],
  },
};
---

<section class="dress" id="dresscode" aria-labelledby="dress-title">
  {/* The header is the only full-bleed thing in this section; everything below
      it is the ordinary shell column. The photograph is a backdrop, so the
      block owns its height and the image is stretched to fill it — its own
      ratio never sizes anything and it cannot shift the section as it decodes. */}
  <div class="dress__header">
    <div class="dress__header-media">
      {/* Like the Story photograph, deliberately carries no `data-anim`. These
          are the two images that have been reported blank, and a full-bleed
          backdrop under a text card gains almost nothing from a clip wipe while
          risking exactly the failure that keeps happening. The safety nets in
          index.astro would catch it; not animating it at all means there is
          nothing to catch. */}
      <Picture
        class="dress__header-photo"
        src={headerPhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1400, 1920]}
        width={1920}
        sizes="100vw"
        alt="Steeja walking along a low ledge in a red gingham dress with her arms out for balance, laughing, Arjun behind her with one arm raised, against a weathered yellow wall painted with a fan palm."
        loading="lazy"
        decoding="async"
      />
      {/* Never lets the card's edge land on a bright patch. */}
      <div class="dress__header-wash" aria-hidden="true"></div>
    </div>

    <div class="dress__bubble">
      <p class="dress__eyebrow" data-anim="head">What to wear</p>
      <h2 class="dress__title" id="dress-title" data-anim="head2">Dressed in peach and beige</h2>

      <p class="dress__intro">
        We&rsquo;d love everyone to match the day. Here&rsquo;s what we have in mind,
        and thank you for playing along.
      </p>
    </div>
  </div>

  <div class="dress__inner">
    {/* The selector and the print. Two columns above 1000px, one below — and
        the print is second in the DOM either way, so on a narrow screen it
        falls under the swatches rather than between the heading and the pills.
    */}
    <div class="dress__with-print">
    <div class="dress__group">
      <h3 class="sr-only" id="dress-group-label">Choose a guest group</h3>

      {/* Real radios, visually hidden but focusable. Switching groups is CSS
          only — the sibling selectors below do the work, so the section is
          fully usable with JavaScript turned off. */}
      {
        GROUPS.map((group, i) => (
          <input
            class="dress__radio"
            type="radio"
            name="dresscode"
            id={`dg-${group.id}`}
            checked={i === 0}
            aria-label={`${group.label} — ${group.garment.toLowerCase()}`}
          />
        ))
      }

      <div class="dress__pills">
        {
          GROUPS.map((group) => (
            <label class="dress__pill" for={`dg-${group.id}`}>
              {group.label}
            </label>
          ))
        }
      </div>

      <div class="dress__panels">
        {
          GROUPS.map((group) => (
            <div class="dress__panel" style={`--illus: ${group.palette[2]}`}>
              <figure class="dress__figure">
                <svg
                  class="dress__svg"
                  viewBox="0 0 240 320"
                  role="img"
                  aria-label={ILLUSTRATION[group.id]?.alt}
                >
                  {ILLUSTRATION[group.id]?.paths.map((d) => <path d={d} />)}
                </svg>
              </figure>

              <div class="dress__palette">
                <p class="dress__garment">{group.garment}</p>

                {/* Hidden until the script confirms the Clipboard API exists —
                    an instruction for a capability the browser lacks is as
                    broken as a dead button. */}
                <p class="dress__hint" data-copy-hint hidden>
                  Tap a colour to copy its code &mdash; helpful if you&rsquo;re having
                  something tailored.
                </p>

                <ul class="dress__swatches">
                  {
                    group.palette.map((hex) => (
                      <li class="dress__swatch-cell">
                        {/* Inert by default; upgraded to a real button below. */}
                        <span class="dress__swatch" data-hex={hex}>
                          <span class="dress__chip" style={`--chip: ${hex}`} />
                          <span class="dress__hex">{hex}</span>
                        </span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          ))
        }
      </div>

      <p class="sr-only" role="status" data-copy-status></p>
    </div>

      {/* Laid on the page rather than printed into it. No reveal animation and
          explicit dimensions, so the mount's box is reserved before the photo
          lands and nothing moves when it does. */}
      <figure class="dress__print">
        <Picture
          class="dress__print-photo"
          src={shoePhoto}
          formats={['avif', 'webp']}
          widths={[260, 520]}
          width={520}
          height={416}
          sizes="clamp(180px, 22vw, 260px)"
          alt="Steeja's white trainers on the ledge, below the hem of her red checked dress."
          loading="lazy"
          decoding="async"
        />
        {/* Top-left, for two reasons, and the tilt is the second of them.

            It is the inward corner. Above 1000px the print is the right-hand
            column, so its top-left faces back into the swatches and the mark is
            found on the way past them; its top-right sits out on the page's
            outer margin with nothing around it, which is where a small drawing
            goes to look like an accident.

            And the mount is laid down at -2.5deg, which — CSS angles being
            clockwise-positive — is anticlockwise, so it is the LEFT of the two
            top corners that has dropped and the right that has lifted. Pinning
            the low one reads as the print having settled around a tack; pinning
            the high one reads as a picture hung from a nail, which is a more
            literal and much less casual thing than this section wants. It is
            also the corner that rises when the mount straightens itself on
            hover, so the print's unwinding and the pin's own give happen in the
            same place rather than at opposite ends of the frame.

            Story.astro takes the top-right, both to keep two identical marks
            from reading as a rule and because over there the mirrored layout
            makes the right the inward one. */}
        <span class="dress__pin"><PinFlower /></span>
        <figcaption class="dress__print-caption">first steps, together</figcaption>
      </figure>
    </div>

    <div class="dress__avoid">
      <h3 class="dress__avoid-title">Please avoid</h3>

      <ul class="dress__swatches dress__swatches--avoid">
        {
          AVOID.map((colour) => (
            <li class="dress__swatch-cell">
              <span class="dress__swatch dress__swatch--avoid">
                <span class="dress__chip dress__chip--avoid" style={`--chip: ${colour.hex}`} />
                <span class="dress__hex">{colour.name}</span>
              </span>
            </li>
          ))
        }
      </ul>

      <p class="dress__avoid-note">
        We kindly ask our female guests to avoid white and cream &mdash; those are
        reserved for the bride.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var section = document.getElementById('dresscode');
    if (!section) return;
    if (!navigator.clipboard || !navigator.clipboard.writeText) return;

    var hints = section.querySelectorAll('[data-copy-hint]');
    for (var h = 0; h < hints.length; h++) hints[h].hidden = false;

    var status = section.querySelector('[data-copy-status]');
    var swatches = section.querySelectorAll('.dress__swatch[data-hex]');

    for (var i = 0; i < swatches.length; i++) {
      (function (span) {
        var hex = span.getAttribute('data-hex');

        // Swap the inert span for a real button, so focus, Enter and Space all
        // behave without re-implementing any of them.
        var button = document.createElement('button');
        button.type = 'button';
        button.className = span.className + ' dress__swatch--copy';
        // Astro scopes component CSS with a `data-astro-cid-*` ATTRIBUTE, not a
        // class, so copying className alone hands the replacement a set of
        // selectors that no longer match it — the swatch loses its own styling
        // and falls back to a default grey UA button. `dataset` round-trips the
        // scope attribute along with `data-hex`.
        Object.assign(button.dataset, span.dataset);
        button.setAttribute('aria-label', 'Copy colour code ' + hex);
        button.innerHTML = span.innerHTML;
        span.replaceWith(button);

        var label = button.querySelector('.dress__hex');
        var revert;

        button.addEventListener('click', function () {
          navigator.clipboard.writeText(hex).then(
            function () {
              label.textContent = 'Copied';
              if (status) status.textContent = hex + ' copied to the clipboard.';
              clearTimeout(revert);
              revert = setTimeout(function () {
                label.textContent = hex;
              }, 1600);
            },
            function () {
              if (status) status.textContent = 'Could not copy ' + hex + '.';
            },
          );
        });
      })(swatches[i]);
    }
  })();
</script>

<style>
  .dress {
    background-color: var(--color-shell);
    /* One name for the photograph's height, because the mobile layout has to
       offset the bubble by a fraction of it. Declared once so the two can never
       be edited apart. */
    --dress-header-h: clamp(52svh, 60vh, 560px);
  }

  .dress__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
  }

  /* -- header on the photograph -------------------------------------------- */

  .dress__header {
    position: relative;
    /* Contains the bubble's top margin. Without it that margin collapses
       through the header and moves the header itself — which, since the
       photograph is absolutely positioned inside it, takes the photograph
       along too and lands the card back on its top edge with none of the
       frame showing above. The 900px branch below is `display: grid`, which
       already contains it. */
    display: flow-root;
    /* Full-bleed: a direct child of a section that sets no width of its own. */
    width: 100%;
    /* Deliberately NOT clipped. On a phone the card hangs off the bottom of the
       photograph and onto the shell — that overhang is the whole composition,
       and `overflow: hidden` here is what would eat it. The photograph does its
       own clipping, one level down. */
    background-color: var(--color-ink);
  }

  .dress__header-media {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--dress-header-h);
    overflow: hidden;
  }

  .dress__header-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Centred horizontally, just above the middle vertically: the two of them
       are mid-frame and the wall fills the rest, so a wide slice taken from
       slightly above centre keeps both of them and the painted palm. Declared,
       like every image on this page.

       No `filter`. The lift that used to be here existed only to rescue a frame
       exposed for a single lamp; this one is daylight on a yellow wall and any
       brightening would blow the wall out. */
    object-position: 50% 45%;
  }

  .dress__header-wash {
    position: absolute;
    inset: 0;
    /* Runs to the bottom on a phone, where the card sits under the photograph,
       and to the right on a wide screen, where it sits beside it. Either way
       the card's edge lands on something dark rather than on a bright patch.

       Deeper than it was, because the photograph behind it is now a sunlit
       yellow wall rather than a near-black frame — on a bright ground a light
       wash leaves the card's edge dissolving into it. */
    background-image: linear-gradient(
      180deg,
      rgb(var(--shade-rgb) / 0) 45%,
      rgb(var(--shade-rgb) / 0.45) 100%
    );
  }

  .dress__bubble {
    position: relative;
    /* Below 900px the card is full width and starts 85% of the way down the
       photograph, so it covers the bottom 15% of it and the rest of the frame
       stays visible above. */
    margin: calc(var(--dress-header-h) * 0.85) clamp(1rem, 4vw, 2rem) 0;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 24px;
    background-color: var(--color-shell);
    /* Ink on shell, exactly as everywhere else on the page. No text on the
       photograph at any width. */
    color: var(--color-ink);
    box-shadow: 0 18px 48px rgb(var(--shade-deep-rgb) / 0.28);
  }

  @media (min-width: 900px) {
    .dress__header {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      min-height: var(--dress-header-h);
    }

    .dress__header-media {
      inset: 0;
      height: auto;
    }

    .dress__header-wash {
      background-image: linear-gradient(
        90deg,
        rgb(var(--shade-rgb) / 0) 40%,
        rgb(var(--shade-rgb) / 0.45) 100%
      );
    }

    .dress__bubble {
      /* Right, with the brief's 6vw margin, and centred on the frame. In flow
         rather than absolutely positioned, so a longer intro grows the block
         instead of overflowing it — and when it does grow past the
         photograph, the card is what crosses the edge. */
      justify-self: end;
      max-width: 30rem;
      margin: clamp(2rem, 5vw, 3.5rem) 6vw;
    }
  }

  .dress__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dress__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .dress__intro {
    max-width: 56ch;
    margin-top: clamp(1rem, 2.2vw, 1.5rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* -- group selector ------------------------------------------------------ */

  .dress__group {
    /* First thing in the shell column now that the header carries the words,
       so it owns no top offset of its own — `.dress__inner` already pads it. */
    margin-top: 0;
  }

  .dress__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    border: 0;
  }

  .dress__pills {
    display: flex;
    flex-wrap: wrap; /* two rows on a phone, never a sideways scroll */
    gap: 0.6rem;
  }

  .dress__pill {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border: 1px solid var(--color-muted);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.85rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .dress__panel {
    display: none;
  }

  /*
   * The whole selector is CSS. Enumerated by index rather than by id so a
   * fourth group (children, currently commented out in the data) needs no
   * change here; the unused fourth rule costs a few dozen bytes.
   */
  .dress__radio:nth-of-type(1):checked ~ .dress__pills .dress__pill:nth-child(1),
  .dress__radio:nth-of-type(2):checked ~ .dress__pills .dress__pill:nth-child(2),
  .dress__radio:nth-of-type(3):checked ~ .dress__pills .dress__pill:nth-child(3),
  .dress__radio:nth-of-type(4):checked ~ .dress__pills .dress__pill:nth-child(4) {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-shell);
  }

  /* The radio is off-screen, so its focus ring has to be drawn on the pill. */
  .dress__radio:nth-of-type(1):focus-visible ~ .dress__pills .dress__pill:nth-child(1),
  .dress__radio:nth-of-type(2):focus-visible ~ .dress__pills .dress__pill:nth-child(2),
  .dress__radio:nth-of-type(3):focus-visible ~ .dress__pills .dress__pill:nth-child(3),
  .dress__radio:nth-of-type(4):focus-visible ~ .dress__pills .dress__pill:nth-child(4) {
    outline: 2.5px solid var(--color-ochre);
    outline-offset: 3px;
  }

  .dress__radio:nth-of-type(1):checked ~ .dress__panels .dress__panel:nth-child(1),
  .dress__radio:nth-of-type(2):checked ~ .dress__panels .dress__panel:nth-child(2),
  .dress__radio:nth-of-type(3):checked ~ .dress__panels .dress__panel:nth-child(3),
  .dress__radio:nth-of-type(4):checked ~ .dress__panels .dress__panel:nth-child(4) {
    display: grid;
  }

  .dress__panels {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .dress__panel {
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 760px) {
    .dress__panel {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
    }
  }

  /* -- illustration -------------------------------------------------------- */

  .dress__figure {
    margin: 0;
  }

  .dress__svg {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    margin-inline: auto;
  }

  .dress__svg path {
    fill: var(--illus);
    fill-opacity: 0.22;
    stroke: rgb(var(--ink-rgb) / 0.8);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* -- palette ------------------------------------------------------------- */

  .dress__garment {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-ink);
  }

  .dress__hint {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .dress__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.1rem);
    margin: clamp(1rem, 2.2vw, 1.4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .dress__swatch {
    display: block;
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    text-align: center;
  }

  .dress__swatch--copy {
    cursor: pointer;
  }

  .dress__chip {
    display: block;
    width: clamp(64px, 14vw, 84px);
    height: clamp(64px, 14vw, 84px);
    border: 1px solid var(--color-ochre);
    background-color: var(--chip);
  }

  .dress__hex {
    display: block;
    margin-top: 0.5rem;
    /* On shell, never on the swatch — some of these are far too light to
       carry text. */
    font-size: 0.72rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  /* -- please avoid -------------------------------------------------------- */

  .dress__avoid {
    margin-top: clamp(2.5rem, 5.5vw, 4rem);
    padding-top: clamp(2rem, 4.5vw, 3rem);
    border-top: 1px solid var(--color-ochre);
  }

  .dress__avoid-title {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .dress__chip--avoid {
    border-color: var(--color-muted);
    /* A hairline struck corner to corner. */
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--color-muted) calc(50% - 0.5px),
      var(--color-muted) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }

  /* -- the print ----------------------------------------------------------- */

  .dress__with-print {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    /* One column below 1000px, and the print is second in the DOM, so it lands
       under the swatches rather than between the heading and the pills. */
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .dress__with-print {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .dress__print {
    /* The containing block for the pin. The rotation below already makes one —
       a transform does that for absolutely positioned descendants too, not just
       for fixed ones — so this line changes nothing today. It is here because
       the day somebody decides the print should sit straight and deletes the
       rotate, the pin would silently fly off to the corner of whichever
       ancestor happened to be positioned, and that is not a trap worth leaving
       behind for a single declaration. */
    position: relative;
    /* The mount, not the photograph: shell all round, even on three sides and
       roughly double at the foot, which is the proportion that reads as a
       print rather than as a bordered image. */
    width: clamp(180px, 22vw, 260px);
    margin: 0;
    padding: 10px 10px 22px;
    background-color: var(--color-shell);
    box-shadow: 0 10px 30px rgb(24 16 11 / 0.16);
    /* Laid down slightly askew. Straightens on hover, and only where hovering

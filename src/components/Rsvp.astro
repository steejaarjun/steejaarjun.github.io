---
/**
 * The reply form.
 *
 * The word "RSVP" is the id and nothing else. It is an initialism of a French
 * sentence, and a fair share of this guest list would have to be told what it
 * stands for before they could answer it. Everything a guest reads here is a
 * plain English question.
 *
 * ---------------------------------------------------------------------------
 * Where the answer goes
 * ---------------------------------------------------------------------------
 * Straight to the deployed edge function, never to the database. `anon` has no
 * privileges on `public.rsvps` at all — not insert, not anything — so a direct
 * PostgREST call would be refused even if one were written. The function holds
 * the Turnstile secret and writes with the service role. See the RLS block at
 * the foot of supabase/migrations/0001_rsvps.sql before doubting this.
 *
 * The POST carries the anon key in `Authorization` and `apikey` because the
 * deployed function has `verify_jwt` on: Supabase's gateway rejects the request
 * before the function ever runs without it. That key is public by design and is
 * already in the bundle — it grants nothing on its own.
 *
 * `@supabase/supabase-js` is deliberately not imported here. It is ~40 kB to do
 * one `fetch` of one URL, and pulling it onto the guest page would also put a
 * database client one autocomplete away from a future edit to this file.
 *
 * ---------------------------------------------------------------------------
 * No JavaScript
 * ---------------------------------------------------------------------------
 * There is no progressive-enhancement story available: the site is a static
 * build on GitHub Pages, so there is no server of ours to receive a native form
 * POST, and the write is gated on a captcha that only a server can verify. So
 * rather than shipping a form that silently does nothing, a browser with script
 * switched off is given the WhatsApp numbers instead.
 *
 * That decision is made in CSS, by `@media (scripting: none)` — at parse time,
 * before the first frame. It was made by a `.rsvp-js` class the script added
 * instead, and that cost the page its entire CLS: the form appeared and the
 * fallback vanished one frame in, moving the footer about 1090px while it was
 * still on screen. See the note above the rules themselves for what the swap
 * costs in return, which is the script-ran-but-threw case.
 *
 * ---------------------------------------------------------------------------
 * Turnstile
 * ---------------------------------------------------------------------------
 * Rendered explicitly, and the script is not in the document until the section
 * first crosses the viewport. Cloudflare's api.js is ~80 kB and this section is
 * the last but one on a long page — most visits will never reach it, and a
 * visit that does not reach it should not pay for it. It also means the
 * Lighthouse run, which never scrolls, measures a page that has no third-party
 * script on it at all.
 */
import { CONTACTS } from '../data/contacts';
import { DIAL_CODES } from '../data/dial-codes';

/* India first because that is where most of this list is, Switzerland second
   because that is where the rest of it is. Everything else is alphabetical by
   name — `localeCompare` rather than a raw sort so Côte d'Ivoire, Curaçao,
   Réunion, São Tomé and Türkiye land where an English reader looks for them.
   Both run at build; the browser sorts nothing. */
const PINNED = ['IN', 'CH'];
const pinned = PINNED.map((iso) => DIAL_CODES.find((c) => c.iso === iso)!);
const rest = DIAL_CODES.filter((c) => !PINNED.includes(c.iso)).sort((a, b) =>
  a.name.localeCompare(b.name, 'en'),
);

/* The one contact the success panel offers. First in the list, and the same
   person the Contact section leads with. */
const primary = CONTACTS[0];
---

<section class="rsvp" id="rsvp" aria-labelledby="rsvp-title">
  <div class="rsvp__inner">
    <p class="rsvp__eyebrow" data-anim="head">One last thing</p>
    <h2 class="rsvp__title" id="rsvp-title" data-anim="head2">
      Will you be joining us?
    </h2>

    <p class="rsvp__intro">
      Please let us know by 20 August 2026 &mdash; even if you&rsquo;ve already told us
      in person. It helps us plan seating and food.
    </p>

    {/* Visible until the script below has run. Not `hidden` first and revealed
        after: the failure this stands in for is "the script never ran", and a
        fallback that needs the script to appear is no fallback. */}
    <div class="rsvp__nojs">
      <p class="rsvp__nojs-lead">
        This form needs JavaScript. Please send your answer by WhatsApp instead.
      </p>
      <ul class="rsvp__nojs-list">
        {
          CONTACTS.map((contact) => (
            <li>
              <a
                class="rsvp__nojs-link"
                href={`https://wa.me/${contact.phone.replace(/\D/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {contact.name}
                <span class="rsvp__nojs-number">{contact.display}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* `novalidate`: the browser's own bubbles cannot be styled, vanish on the
        next click and are announced inconsistently. Validation below is ours,
        on blur and on submit, and it writes into the page where it stays. */}
    <form class="rsvp__form" id="rsvp-form" novalidate>
      <!-- 1. Name --------------------------------------------------------- -->
      <div class="rsvp__row rsvp__row--pair">
        <div class="rsvp__field">
          <label class="rsvp__label" for="rsvp-first">First name</label>
          <input
            class="rsvp__input"
            id="rsvp-first"
            name="first_name"
            type="text"
            maxlength="80"
            autocomplete="given-name"
            aria-describedby="rsvp-first-error"
            required
          />
          <p class="rsvp__error" id="rsvp-first-error" role="alert"></p>
        </div>

        <div class="rsvp__field">
          <label class="rsvp__label" for="rsvp-last">Last name</label>
          <input
            class="rsvp__input"
            id="rsvp-last"
            name="last_name"
            type="text"
            maxlength="80"
            autocomplete="family-name"
            aria-describedby="rsvp-last-error"
            required
          />
          <p class="rsvp__error" id="rsvp-last-error" role="alert"></p>
        </div>
      </div>

      <!-- 2. Companions ---------------------------------------------------- -->
      {/* Directly under the names, because it is the same question: who is this
          reply for. A guest bringing three people answers that while they are
          still thinking about names.

          Written for the oldest guest on the list, which is what every choice
          in this block is for. No colour coding and no icons — a green tick and
          an amber pill mean nothing to somebody who has never been taught the
          convention, and this audience skews well past the age where that
          vocabulary is assumed. Plain sentences instead, and one running total
          at the foot that says the answer back in words.

          The hard part is not adding people, it is knowing whether you counted
          yourself. So it is said three times in three different ways: in the
          heading ("who ELSE"), in the line under it ("you are already
          counted"), and in the total, which is the only one that reflects what
          the guest has actually done.

          Hidden entirely once both answers are No. The database refuses a
          decline that brings twenty people with it (see the edge function), and
          a field that can only produce a rejection should not be on the screen.
      */}
      <fieldset class="rsvp__field rsvp__fieldset" id="rsvp-companions-field">
        <legend class="rsvp__label">Who else is coming with you?</legend>
        <p class="rsvp__hint" id="rsvp-companions-hint">
          You are already counted. Please add only the people coming with you.
        </p>

        {/* A box rather than a bare line. Empty state as one line of grey text
            reads as a caption about the control above it; the same words inside
            a border read as the current answer, which is what this is. */}
        <p class="rsvp__empty" id="rsvp-companions-empty">
          Nobody added yet &mdash; that means you&rsquo;re coming on your own.
        </p>

        <div class="rsvp__people" id="rsvp-people"></div>
        <button class="rsvp__add" id="rsvp-add" type="button">Add a person</button>

        {/* The line that tells a guest whether they got it right, and the reason
            the rest of the block can stay this plain.

            Deliberately a sentence and not a counter: no badge, no pill, no
            digit set apart in its own box. "3" beside a label is something to
            be decoded; "In total you are 3 people." is something to be read and
            checked against the room. Body size and ink, like every other
            sentence on the page.

            Inside the fieldset, so it leaves with the question when both
            answers are No — a guest who is not coming should not be told how
            many of them are not coming. Filled in by syncPeople(), which is the
            one function every add, remove and reset already goes through, so it
            cannot fall out of step with the rows above it. */}
        <p class="rsvp__total" id="rsvp-total" aria-live="polite"></p>
      </fieldset>

      {/* Cloned by the script for each row. Inert in the document: a <template>
          holds an inactive document fragment, so nothing inside it is a form
          control, is focusable, or is submitted. Kept beside the fieldset it
          fills rather than left behind where the block used to be.

          Two labels per row, not one. The row is "Person 2" and the box inside
          it is "Their name" — the number is the guest's place in the list and
          the label is what to type, and one word cannot be both. `role="group"`
          with `aria-labelledby` is what carries the number to a screen reader
          without nesting a second <fieldset> inside the one this row is
          already in. */}
      <template id="rsvp-person-template">
        <div class="rsvp__person" role="group">
          <p class="rsvp__person-title" data-person-title></p>

          <div class="rsvp__field rsvp__person-name">
            <label class="rsvp__label rsvp__label--small" data-person-label>
              Their name
            </label>
            <input class="rsvp__input" type="text" maxlength="80" data-person-name />
            <p class="rsvp__error" role="alert" data-person-error></p>
          </div>

          <div class="rsvp__person-age" role="radiogroup" data-person-age>
            <span class="rsvp__label rsvp__label--small" data-person-age-label>Age</span>
            <div class="rsvp__choices rsvp__choices--tight">
              <label class="rsvp__choice">
                <input type="radio" value="adult" checked data-person-type />
                <span>Adult</span>
              </label>
              <label class="rsvp__choice">
                <input type="radio" value="child" data-person-type />
                <span>Child under 12</span>
              </label>
            </div>
          </div>

          {/* Text, not an aria-label. "Remove" on its own is a button a guest
              has to work out the target of by looking at what it is nearest to,
              and on a phone with three rows on screen that is a real mistake to
              make. What it says is what it does, and a screen reader and the
              eye are then reading the same words. */}
          <button class="rsvp__remove" type="button" data-person-remove></button>
        </div>
      </template>

      <!-- 3. The two questions -------------------------------------------- -->
      {/* Radios, not checkboxes, and that is the whole point of asking twice.
          An unticked checkbox cannot be told apart from "no" — it is both "I am
          not coming" and "I did not read this". Two radios have three states:
          yes, no, and nothing chosen, and only the third is allowed to be a
          validation error. */}
      <fieldset class="rsvp__field rsvp__fieldset">
        <legend class="rsvp__label">
          Will you come to the Wedding Mass at 3:30&nbsp;PM?
        </legend>
        <div class="rsvp__choices" aria-describedby="rsvp-mass-error">
          <label class="rsvp__choice">
            <input type="radio" name="attending_mass" value="yes" />
            <span>Yes</span>
          </label>
          <label class="rsvp__choice">
            <input type="radio" name="attending_mass" value="no" />
            <span>No</span>
          </label>
        </div>
        <p class="rsvp__error" id="rsvp-mass-error" role="alert"></p>
      </fieldset>

      <fieldset class="rsvp__field rsvp__fieldset">
        <legend class="rsvp__label">
          Will you come to the Reception at 6:00&nbsp;PM?
        </legend>
        <div class="rsvp__choices" aria-describedby="rsvp-reception-error">
          <label class="rsvp__choice">
            <input type="radio" name="attending_reception" value="yes" />
            <span>Yes</span>
          </label>
          <label class="rsvp__choice">
            <input type="radio" name="attending_reception" value="no" />
            <span>No</span>
          </label>
        </div>
        <p class="rsvp__error" id="rsvp-reception-error" role="alert"></p>
      </fieldset>

      <!-- 4. Message ------------------------------------------------------ -->
      <div class="rsvp__field">
        <label class="rsvp__label" for="rsvp-message">
          Anything you&rsquo;d like to tell us? <span class="rsvp__optional">(optional)</span>
        </label>
        <textarea
          class="rsvp__input rsvp__textarea"
          id="rsvp-message"
          name="message"
          rows="4"
          maxlength="1000"
          aria-describedby="rsvp-message-count"></textarea>
        {/* Empty and silent until the last 200 characters. A counter that is
            always there is a limit announced to everyone who was never going to
            reach it. `aria-live="polite"` so it is not read on every keystroke. */}
        <p class="rsvp__count" id="rsvp-message-count" aria-live="polite"></p>
      </div>

      <!-- 5. Phone -------------------------------------------------------- -->
      {/* Last, and below the message rather than above it. It sat between the
          companions block and the two attendance questions, which put the one
          optional field on the form — and the only one that opens a 200-item
          country list — in the middle of the parts that are required. A guest
          who stops there has answered nothing the couple actually need.
          Everything required now runs without interruption from the first name
          to the last question, and the two optional fields are together at the
          foot where either can be skipped without losing the thread.

          Two controls, one answer, so the label belongs to the group rather
          than to either box. A <fieldset> with a <legend> is how that is said
          without inventing an ARIA pattern; each control then carries its own
          short <label>, hidden from sight but not from a screen reader. */}
      <fieldset class="rsvp__field rsvp__fieldset">
        <legend class="rsvp__label">
          Phone number <span class="rsvp__optional">(optional)</span>
        </legend>
        <p class="rsvp__hint" id="rsvp-phone-why">
          We&rsquo;ll only use this if we need to ask you something about your reply.
        </p>
        <div class="rsvp__phone">
          <label class="rsvp__sr" for="rsvp-dial">Country code</label>
          <select
            class="rsvp__input rsvp__select"
            id="rsvp-dial"
            name="dial"
            aria-describedby="rsvp-phone-error"
          >
            {/* `value` is the ISO code and the dial code rides in a data
                attribute, because dial codes are not unique — +1 is Canada and
                the United States, +7 is Kazakhstan and Russia. Two <option>s
                sharing a value make the selection ambiguous to read. The script
                takes the number from `dataset.dial`, never from the label. */}
            {
              pinned.map((c) => (
                <option value={c.iso} data-dial={c.dial} selected={c.iso === 'IN'}>
                  {c.name} +{c.dial}
                </option>
              ))
            }
            <option disabled>──────────</option>
            {
              rest.map((c) => (
                <option value={c.iso} data-dial={c.dial}>
                  {c.name} +{c.dial}
                </option>
              ))
            }
          </select>

          <label class="rsvp__sr" for="rsvp-phone">Phone number</label>
          {/* No `required`. The legend says optional, checkPhone() returns ''
              for an empty field, and the payload sends null — but the attribute
              was still on the control, so a screen reader announced "Phone
              number, required" over a field the form itself treats as optional.
              `novalidate` hid it from everyone reading with their eyes. */}
          <input
            class="rsvp__input"
            id="rsvp-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            maxlength="20"
            aria-describedby="rsvp-phone-hint rsvp-phone-error"
          />
        </div>
        <p class="rsvp__hint" id="rsvp-phone-hint">
          Just the number, without the country code.
        </p>
        <p class="rsvp__error" id="rsvp-phone-error" role="alert"></p>
        {/* A note, not an error, and amber rather than brick: two people in one
            household share a phone all the time, and this is the single most
            likely case on a wedding guest list. It never blocks the send.
            `role="status"` rather than `alert` for the same reason — it is
            announced politely, after whatever the guest is doing. */}
        <p class="rsvp__notice" id="rsvp-phone-notice" role="status"></p>
      </fieldset>

      {/* There was an email field here. It is gone: nobody was going to write
          to these addresses, and asking for one is asking a guest to hand over
          a contact detail for no purpose they can see. The DATABASE COLUMN
          stays — nullable and unwritten — because dropping it would need a
          migration and would destroy the addresses already collected. See the
          note beside the insert in supabase/functions/rsvp/index.ts. */}

      <!-- 6. Honeypot ----------------------------------------------------- -->
      {/* Off-screen by position, never `display: none`. A hidden field is the
          first thing a form-filling bot checks for, and skipping it is one
          line; a field that is in the layout and simply not where the eye is
          gets filled in. Out of the tab order and out of the accessibility
          tree, so no human ever meets it either way. The edge function answers
          a filled honeypot with a plausible success — a bot that gets a 400
          learns it was caught. */}
      <div class="rsvp__honeypot" aria-hidden="true">
        {/* No visible label text, and no longer called `website`.
            ------------------------------------------------------------------
            The previous version had `name="website"` and a <label>Website</label>,
            and Chrome autofilled it from a saved profile — which flagged a real
            guest's reply as spam. Browsers match on the name, the id, the label
            text and the surrounding words, so all four are now meaningless.

            `autocomplete="new-password"` rather than "off": browsers ignore
            "off" for non-credential fields as an anti-dark-pattern measure, but
            they will not autofill a field claiming to be a new password.
            data-1p-ignore and data-lpignore ask 1Password and LastPass to stay
            out of it too.

            Still positioned off-screen rather than display:none — a hidden
            field is the first thing a form-filling bot skips. */}
        <input
          id="rsvp-hp-ref"
          name="hp_ref"
          type="text"
          tabindex="-1"
          autocomplete="new-password"
          data-1p-ignore
          data-lpignore="true"
          data-form-type="other"
        />
      </div>

      <!-- 7. Turnstile ---------------------------------------------------- -->
      <div class="rsvp__turnstile" id="rsvp-turnstile"></div>

      {/* A SECOND, separate widget, solely for the duplicate check.
          --------------------------------------------------------------------
          Turnstile tokens are single-use: Cloudflare will not verify the same
          one twice. If the duplicate check spent the widget above, the token
          the guest needs to actually send their reply would be gone, and
          pressing Send straight after leaving the phone field would report
          "that check didn't go through" — a failure this form has already been
          fixed for once.

          So the check gets its own widget in execute mode: invisible, solved on
          demand, and entirely unable to touch the submit token. If it never
          solves, the check silently does not happen and the form is unaffected.
      */}
      <div class="rsvp__turnstile-check" id="rsvp-turnstile-check" aria-hidden="true"></div>

      <p class="rsvp__error rsvp__error--form" id="rsvp-form-error" role="alert"></p>

      <button class="rsvp__submit" id="rsvp-submit" type="submit">
        Send our answer
      </button>
    </form>

    <!-- The success panel, built server-side and filled in by the script. -->
    <div class="rsvp__done" id="rsvp-done" hidden>
      <p class="rsvp__done-line" id="rsvp-done-line"></p>
      <dl class="rsvp__summary" id="rsvp-summary"></dl>
      <a
        class="rsvp__wa"
        id="rsvp-wa"
        href={`https://wa.me/${primary.phone.replace(/\D/g, '')}`}
        data-phone={primary.phone.replace(/\D/g, '')}
        target="_blank"
        rel="noopener noreferrer"
      >
        Message {primary.name} on WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  /**
   * Bundled rather than `is:inline`, so this can be written to be read and
   * still ship small — Vite minifies it and Astro emits it as a deferred
   * module. Anything `is:inline` ships byte for byte, comments included, and
   * this file has too much in it for that to be free.
   *
   * PUBLIC_* values are substituted at build; nothing is fetched to discover
   * them and nothing here is a secret. See .env.example.
   */
  const FUNCTION_URL = `${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/rsvp`;
  const ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

  const MAX_PEOPLE = 20; // matches rsvps_companions_max_20
  const MESSAGE_MAX = 1000;
  const COUNTER_FROM = 800;

  /* The four the function can return, in the words a guest should read. Keyed
     by the function's own codes so the two lists can be diffed by eye. */
  const MESSAGES: Record<string, string> = {
    captcha_failed: 'That check didn’t go through. Please try again.',
    validation_failed:
      'Something in the form isn’t quite right — please check the highlighted fields.',
    rate_limited:
      'We’ve already got your answer. If you need to change it, please call one of our brothers.',
    server_error:
      'Something went wrong on our side. Please try again, or send us a WhatsApp.',
  };

  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const section = document.getElementById('rsvp');
  if (form && section) init(form, section);

  function init(form: HTMLFormElement, section: HTMLElement) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const first = $<HTMLInputElement>('rsvp-first');
    const last = $<HTMLInputElement>('rsvp-last');
    const dial = $<HTMLSelectElement>('rsvp-dial');
    const phone = $<HTMLInputElement>('rsvp-phone');
      const message = $<HTMLTextAreaElement>('rsvp-message');
    const honeypot = $<HTMLInputElement>('rsvp-hp-ref');
    const people = $<HTMLDivElement>('rsvp-people');
    const empty = $<HTMLParagraphElement>('rsvp-companions-empty');
    const total = $<HTMLParagraphElement>('rsvp-total');
    const addButton = $<HTMLButtonElement>('rsvp-add');
    const companionsField = $<HTMLFieldSetElement>('rsvp-companions-field');
    const template = $<HTMLTemplateElement>('rsvp-person-template');
    const counter = $<HTMLParagraphElement>('rsvp-message-count');
    const submit = $<HTMLButtonElement>('rsvp-submit');
    const formError = $<HTMLParagraphElement>('rsvp-form-error');
    const done = $<HTMLDivElement>('rsvp-done');

    let sent = false;
    let widgetId: string | undefined;
    let checkWidgetId: string | undefined;
    /* Resolver for the in-flight duplicate check's token, set while the
       execute-mode widget is solving. Only ever one at a time. */
    let pendingCheck: ((token: string) => void) | null = null;
    /* The last number actually checked, so leaving and re-entering the field
       without editing it does not spend another allowance. */
    let checkedNumber = '';

    /* ---------------------------------------------------------------------
       Errors
       --------------------------------------------------------------------- */
    /* `aria-describedby` is wired in the markup and stays wired: the <p> is
       always there and is empty when there is nothing to say, which screen
       readers skip. Only `aria-invalid` moves, and only on the control. */
    function setError(control: HTMLElement | null, id: string, text: string) {
      const box = document.getElementById(id);
      if (box) box.textContent = text;
      if (control) {
        if (text) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
    }

    function clearError(control: HTMLElement | null, id: string) {
      setError(control, id, '');
    }

    /* ---------------------------------------------------------------------
       Field rules. Each returns an error string, or '' when the field is fine.
       --------------------------------------------------------------------- */
    const trim = (v: string) => v.replace(/\s+/g, ' ').trim();

    function checkName(input: HTMLInputElement, what: string) {
      const v = trim(input.value);
      if (!v) return `Please enter your ${what}.`;
      if (v.length > 80) return `That ${what} is too long.`;
      return '';
    }

    /** To E.164: the selected country's code, then the digits typed. */
    function e164() {
      const code = dial.selectedOptions[0]?.dataset.dial ?? '';
      /* A trunk prefix is a domestic-dialling artefact — 06282… inside India,
         079… inside Switzerland — and it is never part of the international
         form. Dropped rather than rejected: typing the number the way you dial
         it at home is not a mistake a guest should be corrected for. */
      const local = phone.value.replace(/\D/g, '').replace(/^0+/, '');
      return `+${code}${local}`;
    }

    /**
     * Optional, so an empty field is a complete answer and validates.
     *
     * A field left blank and a field filled in wrongly must not collapse into
     * the same outcome: the first is a guest declining to give a number, the
     * second is a typo that would otherwise be stored as no number at all.
     */
    function checkPhone() {
      if (!phone.value.replace(/\D/g, '')) return '';
      if (!/^\+[1-9][0-9]{7,14}$/.test(e164())) {
        return 'That doesn’t look like a complete phone number.';
      }
      return '';
    }

    const answer = (name: string) => {
      const picked = form.querySelector<HTMLInputElement>(
        `input[name="${name}"]:checked`,
      );
      return picked ? picked.value === 'yes' : null;
    };

    /* ---------------------------------------------------------------------
       Companions
       --------------------------------------------------------------------- */
    function rows() {
      return Array.from(people.querySelectorAll<HTMLElement>('.rsvp__person'));
    }

    function syncPeople() {
      const n = rows().length;
      empty.hidden = n > 0;
      addButton.hidden = n >= MAX_PEOPLE;
      /* Each row's radio pair needs a name of its own, or every row on the form
         becomes one group and picking "Child" anywhere unpicks it everywhere.
         Re-stamped on every change because removing row 2 renumbers row 3. */
      rows().forEach((row, i) => {
        row.querySelectorAll<HTMLInputElement>('[data-person-type]').forEach((r) => {
          r.name = `person-${i}`;
        });

        const input = row.querySelector<HTMLInputElement>('[data-person-name]')!;
        const label = row.querySelector<HTMLLabelElement>('[data-person-label]')!;
        const title = row.querySelector<HTMLElement>('[data-person-title]')!;
        const age = row.querySelector<HTMLElement>('[data-person-age]')!;
        const ageLabel = row.querySelector<HTMLElement>('[data-person-age-label]')!;
        const error = row.querySelector<HTMLElement>('[data-person-error]')!;
        const id = `rsvp-person-${i}`;

        /* The number belongs to the ROW, not to the name box. It used to be the
           <label> on the input — which made the box called "Person 2" and left
           nothing anywhere saying what to type into it. Now the row is Person 2
           and the box inside it is "Their name", which is two plain answers to
           two different questions instead of one word doing both jobs badly. */
        title.id = `${id}-title`;
        title.textContent = `Person ${i + 1}`;
        row.setAttribute('aria-labelledby', `${id}-title`);

        input.id = id;
        input.setAttribute('aria-describedby', `${id}-error`);
        label.htmlFor = id;
        error.id = `${id}-error`;

        ageLabel.id = `${id}-age`;
        age.setAttribute('aria-labelledby', `${id}-age`);

        /* Visible text, so the eye and a screen reader are given the same
           sentence. Any aria-label left over from when this said only "Remove"
           would now override the text and quietly say something else. */
        const remove = row.querySelector<HTMLButtonElement>('[data-person-remove]')!;
        remove.removeAttribute('aria-label');
        remove.textContent = `Remove Person ${i + 1}`;
      });

      /* The guest is the 1. Everything else on this block is a way of asking
         the question; this is the answer, in the words it would be said in. */
      const heads = n + 1;
      total.textContent = `In total you are ${heads} ${heads === 1 ? 'person' : 'people'}.`;
    }

    function addPerson() {
      if (rows().length >= MAX_PEOPLE) return;
      const row = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
      people.appendChild(row);
      syncPeople();
      row.querySelector<HTMLInputElement>('[data-person-name]')!.focus();
    }

    addButton.addEventListener('click', addPerson);

    people.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-person-remove]');
      if (!button) return;
      const row = button.closest('.rsvp__person')!;
      const neighbour = row.nextElementSibling ?? row.previousElementSibling;
      row.remove();
      syncPeople();
      /* Focus was on the button that has just been removed from the document,
         which drops it to <body> and loses a keyboard user their place on a
         long form. Somewhere deliberate instead: the next row if there is one,
         otherwise the button that would add a new one. */
      const landing = neighbour?.querySelector<HTMLElement>('[data-person-name]');
      if (landing) landing.focus();
      else addButton.focus();
    });

    /* `blur` does not bubble, `focusout` does — which is what lets one listener
       cover rows that did not exist when it was attached. */
    people.addEventListener('focusout', (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.matches?.('[data-person-name]')) return;
      const error = input.parentElement!.querySelector<HTMLElement>('[data-person-error]')!;
      const bad = !trim(input.value);
      error.textContent = bad ? 'Please enter a name, or remove this row.' : '';
      input.setAttribute('aria-invalid', String(bad));
    });

    function companions() {
      return rows().map((row) => ({
        name: trim(row.querySelector<HTMLInputElement>('[data-person-name]')!.value),
        type: row.querySelector<HTMLInputElement>('[data-person-type]:checked')?.value === 'child'
          ? 'child'
          : 'adult',
      }));
    }

    /* Both answers No means the guest list is not just unnecessary, it is
       rejected by the function. Hide it and forget whatever was typed. */
    function syncDeclined() {
      const declined = answer('attending_mass') === false &&
        answer('attending_reception') === false;
      companionsField.hidden = declined;
      if (declined) {
        people.replaceChildren();
        syncPeople();
      }
    }

    form.addEventListener('change', (event) => {
      const t = event.target as HTMLInputElement;
      if (t.name === 'attending_mass' || t.name === 'attending_reception') {
        syncDeclined();
        clearError(null, `rsvp-${t.name === 'attending_mass' ? 'mass' : 'reception'}-error`);
      }
    });

    /* ---------------------------------------------------------------------
       Message counter — silent until there is something worth saying.
       --------------------------------------------------------------------- */
    message.addEventListener('input', () => {
      const used = message.value.length;
      counter.textContent =
        used >= COUNTER_FROM ? `${MESSAGE_MAX - used} characters left` : '';
    });

    /* ---------------------------------------------------------------------
       Validation, on blur and on submit. Never on input: correcting somebody
       mid-word, before they have finished typing the thing you are complaining
       about, is the single most disliked behaviour a form has.
       --------------------------------------------------------------------- */
    const onBlur = (el: HTMLElement, run: () => string, id: string) =>
      el.addEventListener('blur', () => setError(el, id, run()));

    onBlur(first, () => checkName(first, 'first name'), 'rsvp-first-error');
    onBlur(last, () => checkName(last, 'last name'), 'rsvp-last-error');
    onBlur(phone, checkPhone, 'rsvp-phone-error');

    /* ---------------------------------------------------------------------
       Duplicate check, on blur. Advisory only — it can fail in any way at all
       and the form is unaffected.
       --------------------------------------------------------------------- */
    const notice = $<HTMLParagraphElement>('rsvp-phone-notice');

    phone.addEventListener('blur', () => {
      notice.textContent = '';

      const assembled = e164();
      if (!/^\+[1-9][0-9]{7,14}$/.test(assembled)) return;
      if (assembled === checkedNumber) return;
      checkedNumber = assembled;

      void checkDuplicate(assembled);
    });

    /** Solves the check widget, asks the function, and shows the note. */
    async function checkDuplicate(number: string): Promise<void> {
      const ts = (window as any).turnstile;
      if (!ts || checkWidgetId === undefined) return;

      let token = '';
      try {
        token = await new Promise<string>((resolve) => {
          pendingCheck = resolve;
          /* Reset first: the widget may already hold a spent token from a
             previous check, and `execute` on a solved widget is a no-op. */
          ts.reset(checkWidgetId);
          ts.execute(checkWidgetId);
          // Never leave the guest's blur handler hanging on Cloudflare.
          setTimeout(() => {
            if (pendingCheck === resolve) { pendingCheck = null; resolve(''); }
          }, 8000);
        });
      } catch {
        return;
      }
      if (!token) return;

      try {
        const response = await fetch(FUNCTION_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${ANON_KEY}`,
            apikey: ANON_KEY,
          },
          body: JSON.stringify({ action: 'check_phone', phone: number, turnstile_token: token }),
        });
        const result = await response.json().catch(() => ({}));
        /* Anything other than a clear yes is treated as "no warning". A rate
           limit, a network blip or a server error must never turn into a
           message that makes a guest doubt their own reply. */
        if (response.ok && result.exists === true && phone.value.trim()) {
          notice.textContent =
            'Someone has already replied with this number. If that was you, ' +
            'there’s no need to reply again — but if you’re replying for someone ' +
            'else in your family, please carry on.';
        }
      } catch {
        /* Silent by design. */
      }
    }

    /** Returns the first control that failed, or null when everything passed. */
    function validate(): HTMLElement | null {
      const checks: [HTMLElement, string, string][] = [
        [first, 'rsvp-first-error', checkName(first, 'first name')],
        [last, 'rsvp-last-error', checkName(last, 'last name')],
        [phone, 'rsvp-phone-error', checkPhone()],
      ];

      for (const [el, id, text] of checks) setError(el, id, text);

      const questions: [string, string, string][] = [
        ['attending_mass', 'rsvp-mass-error', 'Please answer yes or no.'],
        ['attending_reception', 'rsvp-reception-error', 'Please answer yes or no.'],
      ];

      for (const [name, id, text] of questions) {
        const missing = answer(name) === null;
        setError(null, id, missing ? text : '');
        const radio = form.querySelector<HTMLInputElement>(`input[name="${name}"]`)!;
        radio.setAttribute('aria-invalid', String(missing));
        if (missing) checks.push([radio, id, text]);
      }

      /* Every empty row is marked, not just the first — a guest who added
         three and filled in one should be shown all three, not sent round the
         loop twice. Only the first is pushed onto `checks`, because only one
         of them can be focused. */
      let firstEmptyRow = true;
      for (const row of rows()) {
        const input = row.querySelector<HTMLInputElement>('[data-person-name]')!;
        const error = row.querySelector<HTMLElement>('[data-person-error]')!;
        const bad = !trim(input.value);
        input.setAttribute('aria-invalid', String(bad));
        error.textContent = bad ? 'Please enter a name, or remove this row.' : '';
        if (bad && firstEmptyRow) {
          firstEmptyRow = false;
          checks.push([input, error.id, error.textContent]);
        }
      }

      const failed = checks.find(([, , text]) => text);
      return failed ? failed[0] : null;
    }

    /* ---------------------------------------------------------------------
       Turnstile — script injected on first sight of the section, widget
       rendered explicitly once it lands.
       --------------------------------------------------------------------- */
    let turnstileRequested = false;

    function loadTurnstile() {
      if (turnstileRequested || !SITE_KEY) return;
      turnstileRequested = true;

      (window as any).__rsvpTurnstileReady = () => {
        const ts = (window as any).turnstile;
        widgetId = ts?.render('#rsvp-turnstile', {
          sitekey: SITE_KEY,
          theme: 'light',
        });
        /* The duplicate check's own widget. `execute` mode means it renders
           nothing and solves only when asked, so it costs a guest nothing
           unless they type a phone number — and it can never consume the
           submit token above. */
        checkWidgetId = ts?.render('#rsvp-turnstile-check', {
          sitekey: SITE_KEY,
          appearance: 'execute',
          execution: 'execute',
          callback: (token: string) => {
            const waiting = pendingCheck;
            pendingCheck = null;
            if (waiting) waiting(token);
          },
          'error-callback': () => {
            const waiting = pendingCheck;
            pendingCheck = null;
            if (waiting) waiting('');
          },
        });
      };
      const s = document.createElement('script');
      s.src =
        'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=__rsvpTurnstileReady';
      s.defer = true;
      document.head.appendChild(s);
    }

    /* Four independent ways this gets loaded, and the reason there are four is
       a failure that actually happened rather than one that might: an
       IntersectionObserver observing this very section, with the section
       squarely inside the viewport, delivered nothing at all — the same
       never-composites case documented at length around the reveal observer in
       index.astro. There it costs an animation. Here it would cost the widget,
       and with no widget there is no token, and with no token the form can
       never be sent — reporting "that check didn't go through", which sends the
       guest hunting for a mistake they did not make.

       So the observer is the optimisation, not the mechanism. The mechanism is
       the third one: if a guest so much as puts the cursor in a field, the
       widget is loaded. That cannot be starved by anything, and it still costs
       a visitor who never reaches this section precisely nothing — which is the
       whole point of not loading it up front. */

    /* 1. Already here — the page was opened at #rsvp, or restored mid-scroll.
          Read from geometry rather than waiting to be told. */
    const box = section.getBoundingClientRect();
    if (box.top < window.innerHeight * 1.5 && box.bottom > 0) loadTurnstile();

    /* 2. Approaching. Half a screen of warning, so on a normal visit the widget
          is solved and waiting before anyone has finished typing their name. */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          loadTurnstile();
        },
        { rootMargin: '50% 0px' },
      );
      io.observe(section);
    } else {
      /* 3a. No observer at all: there is nothing to be clever with. */
      loadTurnstile();
    }

    /* 3b. The floor. Touching the form is unambiguous intent to send it, and
           this fires whatever the observer did or did not do. `focusin`
           bubbles where `focus` does not, so one listener covers every control
           including the rows that do not exist yet. */
    form.addEventListener('focusin', loadTurnstile, { once: true });
    form.addEventListener('pointerdown', loadTurnstile, { once: true });

    /* ---------------------------------------------------------------------
       Submit
       --------------------------------------------------------------------- */
    function resetWidget() {
      /* Turnstile tokens are single-use. Without this, the first failure makes
         every retry fail too — with `captcha_failed`, which sends the guest
         looking for a problem in a field. */
      try {
        (window as any).turnstile?.reset(widgetId);
      } catch {
        /* Nothing to reset; the submit path below reports it. */
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sent || submit.disabled) return;

      formError.textContent = '';

      const invalid = validate();
      if (invalid) {
        invalid.focus();
        formError.textContent = MESSAGES.validation_failed;
        return;
      }

      /* Two different failures wearing one face. If Turnstile is loaded and
         simply has no token, the check is retryable and saying so is right. If
         the script never arrived — a network filter, a corporate proxy, an
         offline moment during the fetch — there is nothing for the guest to
         retry and telling them to try again is a loop. Send them to WhatsApp
         instead, which is the one route that always works. */
      const loaded = typeof (window as any).turnstile !== 'undefined';
      let token = '';
      try {
        token = (window as any).turnstile?.getResponse(widgetId) ?? '';
      } catch {
        token = '';
      }
      if (!token) {
        formError.textContent = loaded ? MESSAGES.captcha_failed : MESSAGES.server_error;
        resetWidget();
        return;
      }

      submit.disabled = true;
      submit.textContent = 'Sending…';

      const payload = {
        first_name: trim(first.value),
        last_name: trim(last.value),
        /* null, not "+91". With no digits typed, `e164()` returns the country
           code on its own, which is not a phone number and would be rejected
           by both the function and the CHECK constraint. */
        phone: phone.value.replace(/\D/g, '') ? e164() : null,
        attending_mass: answer('attending_mass'),
        attending_reception: answer('attending_reception'),
        companions: companionsField.hidden ? [] : companions(),
        message: trim(message.value) || null,
        hp_ref: honeypot.value,
        turnstile_token: token,
      };

      try {
        const response = await fetch(FUNCTION_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            /* The gateway wants a JWT before the function is reached
               (`verify_jwt` is on). The anon key is that JWT, it is public by
               design, and it grants nothing on `public.rsvps`. */
            Authorization: `Bearer ${ANON_KEY}`,
            apikey: ANON_KEY,
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.ok) {
          sent = true;
          showDone(payload);
          return;
        }

        formError.textContent = MESSAGES[result.error] ?? MESSAGES.server_error;
      } catch {
        /* A network failure, an offline phone, a blocked request. */
        formError.textContent = MESSAGES.server_error;
      }

      resetWidget();
      submit.disabled = false;
      submit.textContent = 'Send our answer';
    });

    /* ---------------------------------------------------------------------
       Success. In place, never a navigation: the answer has been accepted and
       a page load is one more thing that can go wrong after the fact.
       --------------------------------------------------------------------- */
    function showDone(payload: any) {
      const coming = payload.attending_mass || payload.attending_reception;

      $('rsvp-done-line').textContent = coming
        ? 'Thank you — we can’t wait to see you.'
        : 'Thank you for letting us know — we’ll miss you.';

      const yesNo = (v: boolean) => (v ? 'Yes' : 'No');
      const items: [string, string][] = [
        ['Name', `${payload.first_name} ${payload.last_name}`],
        ['Phone', payload.phone],
      ];
      items.push(['Wedding Mass', yesNo(payload.attending_mass)]);
      items.push(['Reception', yesNo(payload.attending_reception)]);
      if (payload.companions.length) {
        items.push([
          'Coming with you',
          payload.companions
            .map((c: any) => (c.type === 'child' ? `${c.name} (child)` : c.name))
            .join(', '),
        ]);
      }
      if (payload.message) items.push(['Your message', payload.message]);

      const summary = $('rsvp-summary');
      summary.replaceChildren(
        /* textContent throughout — every value here is something a guest typed
           and none of it is markup. */
        ...items.flatMap(([term, value]) => {
          const dt = document.createElement('dt');
          dt.textContent = term;
          const dd = document.createElement('dd');
          dd.textContent = value;
          return [dt, dd];
        }),
      );

      const wa = $<HTMLAnchorElement>('rsvp-wa');
      wa.href = `https://wa.me/${wa.dataset.phone}?text=${encodeURIComponent(
        `Hello, I've just sent our answer for the wedding. My name is ${payload.first_name}.`,
      )}`;

      form.hidden = true;
      done.hidden = false;
      /* The panel replaced the thing that had focus, so focus has to be given
         somewhere deliberate or it falls to <body>. */
      done.setAttribute('tabindex', '-1');
      done.focus();
    }

    syncPeople();
  }
</script>

<style>
  .rsvp {
    background-color: var(--color-shell);
  }

  .rsvp__inner {
    max-width: 42rem;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.25rem, 6vw, 3rem);
  }

  .rsvp__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .rsvp__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .rsvp__intro {
    max-width: 46ch;
    margin-top: clamp(0.9rem, 2vw, 1.25rem);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* -- the two states -------------------------------------------------------
     The form is the default and the fallback is the exception, decided in CSS
     at first paint rather than by a class the script adds a frame later.

     It used to be the other way round: the fallback shipped visible and
     `.rsvp-js` swapped it for the form once the script ran. That swap was the
     page's entire CLS — one shift of 0.113 at 150ms, in which a ~960px document
     became a ~2050px one and the footer travelled about 1090px down the page
     while it was still on screen. Nothing was mis-sized; the layout was simply
     decided too late.

     `scripting: none` is the same question asked at parse time. The trade is
     that it answers "is script enabled", where `.rsvp-js` answered "did this
     script actually run" — so a browser that runs scripts but throws before
     `init` now shows a form that cannot send instead of the WhatsApp numbers.
     Support is Chrome 120+, Safari 17+, Firefox 113+; older browsers with
     script switched off land on the form rather than the fallback.
  ------------------------------------------------------------------------- */

  /* `:not([hidden])` is load-bearing rather than tidy. The success panel hides
     the form with `form.hidden = true`, and `[hidden]`'s `display: none` lives
     in the user-agent sheet — a bare `display: block` here would outrank it and
     leave the form on screen underneath the thank-you. */
  .rsvp__form:not([hidden]) {
    display: block;
  }

  .rsvp__nojs {
    display: none;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  @media (scripting: none) {
    /* Same selector as the rule above, not a plainer one: a media query adds no
       specificity, so `.rsvp__form { display: none }` would lose to
       `.rsvp__form:not([hidden])` and leave the form on screen with script off.
       Matched, it wins on source order instead. */
    .rsvp__form:not([hidden]) {
      display: none;
    }

    .rsvp__nojs {
      display: block;
    }
  }

  .rsvp__nojs-lead {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .rsvp__nojs-list {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rsvp__nojs-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 1rem;
    text-decoration: none;
  }

  .rsvp__nojs-link:hover,
  .rsvp__nojs-link:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-shell);
  }

  .rsvp__nojs-number {
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  /* -- fields -------------------------------------------------------------- */

  .rsvp__form {
    margin-top: clamp(2rem, 4.5vw, 3rem);
  }

  .rsvp__field {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .rsvp__form > .rsvp__row:first-child,
  .rsvp__form > .rsvp__field:first-child {
    margin-top: 0;
  }

  /* A <fieldset> carries browser defaults that fight every layout it is in. */
  .rsvp__fieldset {
    min-width: 0;
    padding: 0;
    border: 0;
  }

  .rsvp__label {
    display: block;
    /* 1rem is the floor for a label on this page, and this audience is the
       reason. Never smaller, whatever the layout wants. */
    padding: 0;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .rsvp__label--small {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .rsvp__optional {
    font-weight: 400;
    color: var(--color-muted);
  }

  .rsvp__hint {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .rsvp__input {
    display: block;
    width: 100%;
    min-height: 52px;
    margin-top: 0.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid rgb(var(--ink-rgb) / 0.25);
    border-radius: 4px;
    background-color: var(--color-shell);
    color: var(--color-ink);
    font-family: inherit;
    /* Never below 16px. Anything smaller and iOS Safari zooms the page on
       focus, which on a form this long leaves the guest scrolled sideways
       inside a field they cannot see the end of. */
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .rsvp__input:focus-visible {
    border-color: var(--color-ochre);
  }

  .rsvp__input[aria-invalid='true'] {
    border-color: var(--color-brick);
  }

  .rsvp__select {
    /* The native control, deliberately. On a phone it opens the platform's own
       wheel or list, which is searchable by typing and is the one long-list UI
       every guest already knows. */
    appearance: none;
    padding-right: 2.25rem;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-muted) 50%),
      linear-gradient(135deg, var(--color-muted) 50%, transparent 50%);
    background-position: right 1.1rem top 55%, right 0.75rem top 55%;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }

  .rsvp__textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .rsvp__count {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-muted);
    /* Reserved whether or not there is a number in it, so the button below
       does not jump when the counter appears at 800 characters. */
    min-height: 1.275rem;
  }

  /* Two columns only when there is room for two comfortable ones. */
  .rsvp__row--pair {
    display: grid;

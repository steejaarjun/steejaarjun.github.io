---
import { Picture } from 'astro:assets';
// Derived 4:5 master, not the 5760x8640 original — Astro copies an imported
// original into `dist/` alongside its transforms. See scripts/prepare-media.mjs.
import storyPhoto from '../assets/photos/EPW00926-4x5.jpg';
/* The little drawn flower at the corner of the photograph below. Shared with
   Dresscode.astro, which pins its print with the same mark at the opposite
   corner — one file so it stays one drawing. It carries no position of its own;
   see the note in there for why the placing is left to us. */
import PinFlower from './PinFlower.astro';

/**
 * The bride's own words, verbatim. This replaced the placeholder wording the
 * section shipped with, and it is written in the first person where the old
 * copy spoke about the couple in the third — which is the point of it, so
 * nothing here should be smoothed back towards a house voice.
 *
 * Kept in one place so swapping it is an edit to this constant and nothing
 * else.
 *
 * The thank-you that used to close this section has moved to the image band
 * below it (see index.astro). It was the one line here that was addressed to
 * the reader rather than about the couple, and a bordered pull quote was the
 * wrong container for it — it is now the only thing on a full-width
 * photograph, which is the weight it was always asking for.
 */
export const STORY_COPY = {
  paragraphs: [
    'Some stories begin with grand gestures. Ours didn’t.',
    'It started quietly, somewhere between unexpected conversations, shared laughter, and realizing life felt a little lighter together. Before we knew it, the ordinary became our favorite part: the random adventures, the inside jokes, the comfortable silence, and the feeling of finding someone who simply felt like home.',
    'We’re opposites in more ways than one, but somehow our kind of crazy matches perfectly. And if you ask us, we’d probably say we didn’t fall into a fairytale. We laughed our way into one.',
    'On 6 September 2026, we’re choosing forever, and we’d love nothing more than to celebrate the beginning of our next chapter with the people who’ve been part of our story all along.',
    'Now all that’s left is to make a few more unforgettable memories with all of you.',
  ],
};
---

<section class="story" id="story" aria-labelledby="story-title">
  <div class="story__inner">
    <!-- First in the DOM so the stacked phone layout leads with the photo,
         without needing an order override. -->
    <figure class="story__media">
      {/* Deliberately carries NO `data-anim`, and that is the point rather than
          an omission. This photograph has now been invisible twice, both times
          because a hidden start state outlived the thing meant to lift it. The
          safety nets in index.astro would catch it, but the surest way for an
          image not to be hidden by an animation is for no animation to touch it.
          It loads plainly.

          `loading="eager"` for the same reason: it sits two sections down and a
          reader reaches it within a screen or two of scrolling, so there is
          nothing to defer. `width`/`height` are explicit so the 4:5 box is
          reserved before a byte arrives.

          `sizes`: above 900px the photo column settles at ~480px. Below it the
          section's own padding takes a big bite — 56px a side on a 320px phone —
          so the image is nowhere near full width, and declaring that honestly
          drops a 412px phone from the 1400w candidate to the 640w one. */}
      <Picture
        class="story__photo"
        src={storyPhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1400]}
        width={960}
        height={1200}
        sizes="(min-width: 900px) 30rem, (min-width: 700px) 84vw, 72vw"
        alt="Steeja and Arjun laughing in a close embrace, lit warmly against the dark."
        loading="eager"
        decoding="async"
      />
      {/* Top-right — the opposite corner to the one on the dress code's print,
          deliberately. There are only two of these on the whole page and they
          are the same drawing; put them both in the same corner and they stop
          being two things somebody pinned and start being a rule that was
          applied. Right is also the inward corner here, which is the mirror of
          the reasoning over there: above 900px this photograph is the left
          column and the prose is the right, so the mark sits in the gutter
          between them and is found on the way to the words rather than out on
          the page's outer margin. There is no mount on this one — the figure's
          edge is the photograph's edge — so the box is pulled out 5px to lap
          the corner instead of tucked in. Its twin, and the drawing itself, are
          in PinFlower.astro. */}
      <span class="story__pin"><PinFlower /></span>
      <figcaption class="story__caption">Photo: Eden Park Weddings</figcaption>
    </figure>

    <div class="story__text">
      <p class="story__eyebrow" data-anim="head">Our story</p>

      <h2 class="story__title" id="story-title" data-anim="head2">
        A story we never saw coming
      </h2>

      {STORY_COPY.paragraphs.map((text) => <p class="story__paragraph">{text}</p>)}
    </div>
  </div>
</section>

<style>
  .story {
    background-color: var(--color-shell);
  }

  .story__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
  }

  @media (min-width: 900px) {
    .story__inner {
      /* `minmax(0, …)` so a long word in the prose cannot widen its column. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      /* Not `stretch`, which is the grid default: the prose is five paragraphs
         now and runs taller than the 4:5 photograph, and stretching would pull
         the image out of its crop to match. The text column grows and the photo
         keeps its shape, aligned to the top of it rather than floating in the
         middle of a column half again its height. */
      align-items: start;
    }
  }

  .story__media {
    margin: 0;
    /* The containing block for the pin at the photograph's top-right corner.
       Nothing here has ever needed one before, which is why it was not already
       written — with no offsets of its own it moves nothing, and a grid item is
       laid out identically either way. */
    position: relative;
  }

  .story__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Above centre: the frame is a 4:5 crop of a much taller original and both
       their faces sit in the upper half of it, so the browser's 50% 50% takes a
       slice with her chin at the top edge. Declared, like every other image on
       this page — see the note on ImageBand's `focalPoint`. */
    object-position: 50% 40%;
  }

  .story__caption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  /* The pin.
     -----------------------------------------------------------------------
     Pulled 5px out past the corner, so about three quarters of the 22px box is
     over the photograph and the head crosses its top edge. That overlap is the
     whole difference between a flower pinning the picture and a flower placed
     beside it. The overhang is far smaller than `.story__inner`'s padding, which
     never falls below 3.5rem, so it has plenty of room to hang into and cannot
     push the section sideways.

     Out of flow, so it reserves nothing and cannot move a pixel of the layout,
     and `pointer-events: none` so it never intercepts anything. It needs no
     z-index — a positioned element paints above its unpositioned siblings, and
     the photograph is one. */
  .story__pin {
    position: absolute;
    top: -5px;
    right: -5px;
    pointer-events: none;
    /* The head, not the middle of the box. A pin gives at the point it is stuck
       through, and the flower's centre sits at 36% of the box's height, so
       rotating about that keeps the head still and swings the stem. */
    transform-origin: 50% 36%;
  }

  /* The give.
     -----------------------------------------------------------------------
     Both the movement and the transition that carries it live inside this one
     query, rather than being written out plainly and switched off afterwards.
     Under `reduce` — or where the query is not understood at all — there is then
     no transition to inherit and no hover rule to fire, and the pin is simply a
     drawn flower, which is the resting state and the correct one.

     `(hover: hover) and (pointer: fine)` rather than the looser `any-hover`: a
     mark that quietly rotates on first touch and then stays rotated is not a
     hover, it is a crooked drawing, so a touch device is offered nothing at all.
     Three degrees over a 22px mark is a couple of pixels at the tip of the stem
     — it should be felt rather than watched. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .story__pin {
      transition: rotate 250ms ease;
    }

    .story__media:hover .story__pin {
      rotate: 3deg;
    }
  }

  .story__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .story__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .story__paragraph {
    /* The brief's measure. Sits below the column width on a phone, so it only
       bites on wide screens — which is the point of it. */
    max-width: 56ch;
    margin-top: clamp(1.25rem, 2.4vw, 1.75rem);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

</style>

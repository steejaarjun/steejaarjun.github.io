---
/**
 * The day, as a timeline.
 *
 * The one moving part is the ochre rail, which draws itself downward when the
 * list is reached — see the long note above the keyframes for what it does and
 * why it is a wipe rather than a dash offset.
 *
 * It is triggered by its own observer at the foot of this file rather than by
 * the shared `[data-anim]` one in index.astro, and that is deliberate. That
 * observer is backed by a dead man's switch which strips the `js` class 2.5s
 * after `load` so that no photograph can stay hidden; the schedule sits far
 * enough down the page that almost nobody reaches it inside 2.5s, so the rail
 * would reliably be found already drawn. A start state that the reader never
 * sees is worse than no animation, so this one keeps its own trigger with no
 * timer on it — the rail carries no content, so nothing is at risk if it never
 * plays.
 *
 * WHY THE SCRIPT HAS TWO WAYS IN
 * ---------------------------------------------------------------------------
 * An IntersectionObserver's opening delivery needs the document to actually be
 * rendered, and a view that never composites a frame — a prerender, a
 * backgrounded tab, an automation harness driving an occluded window — may
 * never get one. That was watched happening here rather than imagined: list
 * fully inside the viewport, `--armed` on the <ol>, `--play` never added, so
 * the rail sat clipped to nothing and both dots at zero opacity. It rights
 * itself the instant the tab is genuinely looked at, because the observer then
 * delivers — but "it comes back when you look at it" is not the standard this
 * page holds hidden states to, and the whole reason the rail is armed by script
 * is so that it is only ever hidden where it can also be shown.
 *
 * So geometry at DOMContentLoaded sits underneath the observer as a floor. It
 * asks nothing of the renderer — only that the document has been parsed — and
 * it covers the case that is common rather than exotic: a reload keeps its
 * scroll position, and /#schedule lands a guest directly on this list, so
 * "already on screen when the script runs" is the ordinary way to arrive here.
 *
 * The script itself stays terse because `is:inline` ships it byte for byte,
 * comments and all. That is what this block is for.
 */
import {
  EVENTS,
  WEDDING_DATE,
  WEDDING_DATE_LABEL,
  formatTime,
  instantOf,
  utcOffset,
} from '../data/wedding';
import { withBase } from '../lib/paths';

const offset = utcOffset();
---

<section class="schedule" id="schedule" aria-labelledby="schedule-title">
  <div class="schedule__inner">
    <p class="schedule__eyebrow" data-anim="head">The day</p>
    <h2 class="schedule__title" id="schedule-title" data-anim="head2">{WEDDING_DATE_LABEL}</h2>

    <ol class="schedule__list">
      {
        EVENTS.map((event) => (
          <li class="schedule__item">
            <p class="schedule__time">
              <time datetime={`${WEDDING_DATE}T${event.start}:00${offset}`}>
                {formatTime(event.start)}
              </time>
            </p>

            <div class="schedule__rail" aria-hidden="true">
              <span class="schedule__dot" />
            </div>

            <div class="schedule__body">
              <h3 class="schedule__event">{event.title}</h3>
              <p class="schedule__venue">{event.venue}</p>
              <p class="schedule__area">{event.area}</p>
              <p class="schedule__note">{event.note}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="schedule__closing">
      We kindly invite you to join us for the Holy Mass, followed by an evening of
      celebration, dinner and dancing at One Kochi. We can&rsquo;t wait to celebrate this
      special day with you.
    </p>

    <p class="schedule__actions">
      <a class="schedule__cta" href={withBase('wedding.ics')} download="steeja-and-arjun.ics">
        Add to calendar
      </a>
    </p>
  </div>
</section>

<style>
  .schedule {
    background-color: var(--color-shell);
  }

  .schedule__inner {
    max-width: 1240px;
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6.5rem);
  }

  .schedule__eyebrow {
    font-size: 0.7rem;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .schedule__title {
    margin-top: clamp(0.75rem, 1.6vw, 1.1rem);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-ink);
  }

  .schedule__list {
    margin: clamp(2.5rem, 5vw, 3.75rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .schedule__item {
    /* Shared by the time type and the rail, so the dot lands on the optical
       centre of the first line of the time whatever the clamp resolves to. */
    --time-size: clamp(2rem, 4vw, 2.75rem);
    --dot-offset: calc(var(--time-size) * 0.55);
    --gap: clamp(1.75rem, 4vw, 2.5rem);

    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: clamp(0.9rem, 2.5vw, 1.4rem);
    /* Spacing lives in padding rather than a grid gap, so the rail below can
       reach through it with a negative offset and the stroke stays unbroken. */
    padding-block: var(--gap);
  }

  .schedule__item:first-child {
    padding-top: 0;
  }

  .schedule__item:last-child {
    padding-bottom: 0;
  }

  .schedule__rail {
    position: relative;
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .schedule__rail::before {
    content: '';
    position: absolute;
    /* The rail element only covers the grid row; the space between entries is
       the item's own padding. Pulling the stroke out by that much on both ends
       makes consecutive entries' strokes meet exactly at the border box. */
    top: calc(var(--gap) * -1);
    bottom: calc(var(--gap) * -1);
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    background-color: var(--color-ochre);
  }

  /* The stroke starts at the first dot and stops at the last one, rather than
     running off both ends of the list. */
  .schedule__item:first-child .schedule__rail::before {
    top: var(--dot-offset);
  }

  .schedule__item:last-child .schedule__rail::before {
    bottom: auto;
    height: calc(var(--gap) + var(--dot-offset));
  }

  .schedule__dot {
    position: absolute;
    top: var(--dot-offset);
    left: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background-color: var(--color-ochre);
  }

  .schedule__time {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: var(--time-size);
    line-height: 1.1;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .schedule__body {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.4rem;
  }

  @media (min-width: 900px) {
    .schedule__item {
      grid-template-columns: minmax(0, 9rem) 1.25rem minmax(0, 1fr);
    }

    .schedule__time {
      grid-column: 1;
      grid-row: 1;
      text-align: right;
    }

    .schedule__rail {
      grid-column: 2;
      grid-row: 1;
    }

    .schedule__body {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }
  }

  .schedule__event {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .schedule__venue {
    margin-top: 0.7rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .schedule__area {
    margin-top: 0.2rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .schedule__note {
    margin-top: 0.7rem;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .schedule__closing {
    max-width: 56ch;
    margin: clamp(2.75rem, 6vw, 4rem) auto 0;
    text-align: center;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .schedule__actions {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    text-align: center;
  }

  .schedule__cta {
    display: inline-block;
    padding: 0.95rem 1.9rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background-color: var(--color-ink);
    color: var(--color-shell);
    font-size: 0.9rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .schedule__cta:hover,
  .schedule__cta:focus-visible {
    background-color: transparent;
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .schedule__cta {
      transition: none;
    }
  }

  /* The rail draws itself downward.
     -------------------------------------------------------------------------
     Asked for as `stroke-dashoffset` from full to zero, which is how an SVG
     path is drawn on. This rail is not a path. It is a 1px pseudo-element
     whose ends deliberately overhang their row by `--gap` so that consecutive
     segments meet exactly at the border box, with the first starting on its dot
     and the last stopping on its own — geometry that a single SVG line could
     only reproduce by measuring the rows in script. So the same event is
     written the CSS way instead: a wipe that uncovers the stroke from the top
     down. What the eye is given is the same thing a dash offset gives it — a
     line arriving end to end, rather than a line fading in all at once.

     `clip-path` rather than `scaleY`, and that is not a preference. The stroke
     is centred with `transform: translateX(-50%)`, and a transform written here
     would replace that translation rather than add to it, leaving the line half
     a pixel off centre. `clip-path` composes with the existing transform
     instead of competing for the property, and it is already this page's idiom
     for a wipe — see `[data-anim='img']` in global.css.

     The 1.6s is the total for the whole rail, not for each piece of it, so the
     pair reads as one pen travelling down the page: segment one runs 0 -> 0.85s
     and segment two starts at 0.75s and lands at 1.6s. The 0.1s of overlap is
     the tail of the first segment's easing, where the line has visually already
     arrived; without it there is a small but readable pause in mid-air between
     the two dots.

     The `:nth-child` stagger hard-codes two entries because EVENTS in
     src/data/wedding.ts holds exactly two — the Mass and the Reception. A third
     event would draw on the first segment's timing and would want a third step
     written here.

     Fully drawn is the resting state. Both segments and both dots are authored
     where they end up, so with no script, a broken script, an old browser or
     reduced motion the rail is simply a finished rail. The undrawn state exists
     only inside the class the script at the foot of this file adds, and it only
     adds that class once it has confirmed it can also play it. */

  /* Both ends of both curves are written out, and that is not verbosity. A
     keyframe list with only a `from` takes its other end from the element's
     underlying computed style — which here is the armed rule below, the undrawn
     one — so a `from`-only draw would run from hidden to hidden and leave the
     rail wiped out for good. Naming the `to` makes the animation say what it
     means whatever the cascade underneath it happens to be. `inset(0 0 0 0)` is
     the border box of a 1px line, so the finished state clips away nothing. */
  @keyframes schedule-draw {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes schedule-dot {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .schedule__list--armed .schedule__rail::before {
      clip-path: inset(0 0 100% 0);
    }

    /* Opacity only. A dot that scales into place draws the eye to itself rather
       than to the line arriving, and animating its width or height would be a
       layout change on a 7px box. */
    .schedule__list--armed .schedule__dot {
      opacity: 0;
    }

    .schedule__list--play .schedule__rail::before {
      animation: schedule-draw 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .schedule__list--play .schedule__item:nth-child(2) .schedule__rail::before {
      animation-delay: 0.75s;
    }

    /* The first dot is under the pen as it touches down; the second is lit just
       before the stroke settles on it. Two dots, so two steps and no cascade. */
    .schedule__list--play .schedule__dot {
      animation: schedule-dot 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .schedule__list--play .schedule__item:nth-child(2) .schedule__dot {
      animation-delay: 1.4s;
    }
  }
</style>

{/* Terse on purpose: `is:inline` ships byte for byte, comments included, so
    every line of explanation here is a line every guest downloads. The
    reasoning lives in the frontmatter at the top of this file, which does not
    ship at all. */}
<script is:inline>
  /* Two ways in; see the header. */
  (function () {
    var l = document.querySelector('.schedule__list');
    if (!l || !window.IntersectionObserver ||
      matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    l.classList.add('schedule__list--armed');
    function play() {
      o.disconnect();
      l.classList.add('schedule__list--play');
    }
    var o = new IntersectionObserver(function (e) {
      if (e[0].isIntersecting) play();
    }, { rootMargin: '0px 0px -15%' });
    o.observe(l);
    addEventListener('DOMContentLoaded', function () {
      var b = l.getBoundingClientRect();
      if (b.top < innerHeight && b.bottom > 0) play();
    });
  })();
</script>

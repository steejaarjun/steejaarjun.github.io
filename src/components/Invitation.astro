---
import { withBase } from '../lib/paths';
---

{/* The invitation itself, laid on top of the photograph.
    ---------------------------------------------------------------------------
    Everything here used to be printed over the picture inside a double-hairline
    frame. It is a card now, overlapping the bottom edge of the hero so the two
    read as layered rather than stacked, and the hairline motif came with it —
    an inset border at 8px instead of a frame around the whole first screen.

    The page's one <h1> lives here. The hero's names are a caption and a <p>.

    The overlap is a negative margin and nothing else. It resolves at parse time
    from a fixed value, so the card is in its final position on the first frame
    and there is nothing left to reflow — CLS stays 0. */}
<section class="invite" aria-labelledby="couple">
  <div class="invite__card">
    {/* The card opens on the names. It used to open on an eyebrow — "Together
        with their families" — which has been removed, and the <h1> is now the
        first thing inside the border rather than the second. The space above it
        is the card's own padding-top and nothing else; see the note on it
        below, because a large serif with `line-height: 1` needs more of it than
        the other three sides. */}
    <h1 class="invite__names rise" id="couple">
      Steeja <em class="invite__amp">&amp;</em> Arjun
    </h1>

    <div class="invite__rule rise rise--2" aria-hidden="true"></div>

    <p class="invite__when rise rise--2">Sunday, 6 September 2026</p>
    <p class="invite__where rise rise--2">Kerala, India</p>

    {/* A route, not an anchor. The form has its own page, and this button is
        the one most likely to be pressed before the page has been read. */}
    <a class="invite__cta rise rise--3" href={withBase('rsvp')}>
      Let us know you&rsquo;re coming
    </a>

    <p class="invite__deadline rise rise--3">Kindly reply by 20 August 2026</p>
  </div>
</section>

<style>
  /* How far the card climbs onto the photograph.
     -----------------------------------------------------------------------
     Global, and read by the hero too: the caption in the photo's bottom-left
     corner offsets itself by this same number, so the two can never collide
     however either of them changes.

     A length rather than a percentage, deliberately. A percentage margin
     resolves against the container's *width*, not its height, so `-12%` would
     mean something different — and something viewport-dependent — at every
     screen size. These are ~8% and ~12% of the card's own rendered height at
     the two ends, measured rather than guessed. */
  :global(:root) {
    --invite-overlap: 2rem;
  }

  @media (min-width: 900px) {
    :global(:root) {
      --invite-overlap: 3.5rem;
    }
  }

  .invite {
    position: relative;
    /* Above the photograph, and above its scrim. */
    z-index: 3;
    padding-inline: clamp(1rem, 5vw, 2rem);
  }

  .invite__card {
    position: relative;
    max-width: 34rem;
    margin-inline: auto;
    margin-top: calc(-1 * var(--invite-overlap));
    /* Top, then the other three.
       -----------------------------------------------------------------------
       The card used to open on an eyebrow, and the space above the names was
       assembled out of three pieces: this padding, the eyebrow's own line box,
       and the margin on the <h1> under it. With the eyebrow gone that sum has
       to be made deliberately or it is simply whatever is left over, which is
       the difference between a card that was designed and one that had a line
       deleted from it.

       So the <h1> now carries no top margin at all — it is the first thing in
       the box and the space above it is the box's business — and this figure
       is the old three-part total, 48px on a phone and 80px up, arrived at in
       one place instead of three.

       Larger than the other three sides on purpose, and it does not read as
       lopsided for two reasons. The names are set at `line-height: 1`, so
       there is almost no half-leading above the capitals and the measured gap
       is very nearly the whole of what the eye sees — a top padding equal to
       the sides would look tighter than the sides. And everything below the
       names is small type, so an evenly padded box would sit the one heavy
       element hard against the top edge. */
    padding: clamp(3rem, 7.5vw, 5rem) clamp(2rem, 5vw, 3.5rem) clamp(2rem, 5vw, 3.5rem);
    border-radius: 4px;
    background-color: var(--color-shell);
    /* Lifts it off the photograph. No border — the hairline below is the only
       line on the card, and two would be one too many. */
    box-shadow: 0 12px 40px rgb(24 16 11 / 0.14);
    text-align: center;
    text-wrap: balance;
  }

  /* The double-hairline detail, moved off the photograph and onto the card. */
  .invite__card::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid rgb(var(--ochre-rgb) / 0.3);
    border-radius: 2px;
    pointer-events: none;
  }

  /* `.invite__eyebrow` was here. It dressed "Together with their families",
     which has been removed, and it styled nothing else on this card or any
     other — the eyebrows elsewhere on the site carry their own section's class.
     Deleted rather than left behind: a rule matching nothing is a rule someone
     later has to check. */

  .invite__names {
    /* No top margin. The card's padding owns the space above the names now
       that they are the first thing in it — see the note on `.invite__card`. */
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4rem);
    /* Unitless, so swapping in Instrument Serif over the Georgia fallback
       cannot change the block height. */
    line-height: 1;
    color: var(--color-ink);
  }

  .invite__amp {
    font-style: italic;
    color: var(--color-brick);
  }

  .invite__rule {
    width: clamp(2.5rem, 8vw, 4rem);
    height: 1px;
    margin: clamp(1.25rem, 3vw, 1.75rem) auto 0;
    background-color: rgb(var(--ochre-rgb) / 0.55);
  }

  .invite__when {
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    letter-spacing: 0.18em;
    text-indent: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .invite__where {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .invite__cta {
    display: inline-block;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    max-width: 100%;
    padding: 0.95rem 1.9rem;
    border: 1px solid var(--color-ink);
    border-radius: 999px;
    background-color: var(--color-ink);
    color: var(--color-shell);
    font-size: 0.9rem;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .invite__cta:hover,
  .invite__cta:focus-visible {
    background-color: transparent;
    color: var(--color-ink);
  }

  .invite__deadline {
    margin: clamp(1rem, 2.5vw, 1.25rem) 0 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .invite__cta {
      transition: none;
    }
  }
</style>


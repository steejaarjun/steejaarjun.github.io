---
/**
 * The one place every public page's <head> is assembled.
 *
 * Meta lives here rather than in the components that happen to render the
 * content it describes: a description spread across three components is one
 * nobody can read in full, and the failure mode — two pages disagreeing about
 * their own title — is invisible until a crawler reports it.
 *
 * Pages pass what differs and slot in what is genuinely theirs (the hero's
 * preloads, which depend on a build-time image transform, and the reveal
 * script). Everything else below is identical on every page by construction.
 */
import instrumentSerif from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2';
import instrumentSerifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2';
import interVariable from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2';
import shadowsIntoLightTwo from '@fontsource/shadows-into-light-two/files/shadows-into-light-two-latin-400-normal.woff2';

import { absoluteUrl, withBase } from '../lib/paths';

type Props = {
  title: string;
  description: string;
  /** Site-relative, no leading slash. '' is the home page. */
  path?: string;
  /** Overrides the shared link-preview card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Structured data, serialised into one <script type="application/ld+json">. */
  schema?: unknown;
  noindex?: boolean;
};

const {
  title,
  description,
  path = '',
  ogImage = 'og-steeja-arjun.jpg',
  ogImageAlt =
    'Steeja and Arjun sitting together in front of a weathered ochre wall, with their names and the date, Sunday 6 September 2026, Kerala, India.',
  ogTitle = title,
  ogDescription = description,
  schema,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://steejaarjun.github.io');
const canonical = absoluteUrl(path, site);

/* Absolute, always. A relative og:image is the single most common reason a
   preview renders as a bare link — the scraper resolves it against its own
   host, not the page's, and quietly gets a 404. */
const ogImageUrl = absoluteUrl(ogImage, site);

/* Self-hosted, declared inline: a <link> to a font stylesheet would put a
   render-blocking round trip in front of the hero for four @font-face rules.

   HERE, not in index.astro, and that is the whole point of this block. It was
   built on the home page and injected into the home page's head slot, so it
   reached exactly one of the site's pages. /rsvp had `document.fonts.size ===
   0` — not four faces still loading, no faces at all — and rendered the
   monogram in `cursive`, its ampersand in Georgia and every word of the reply
   form in system-ui.

   That is what "the monogram on /rsvp still looks different" turned out to be.
   Its box measured 66.573 x 29.188 on / and 66.333 x 28.521 on /rsvp, and the
   capsule it travels into was 33px narrower, which put the landing 16.6px
   further right. Not one DECLARED property differed between the two pages —
   font-size, colour, font-family, line-height, top, left and text-shadow all
   matched, and of 516 computed values only the ones derived from layout were
   apart. Nothing was wrong with the CSS. The fonts were simply not there, and
   nothing in the source of the page that was wrong said so.

   So this is not "shared for tidiness": a page that does not get this block
   does not get the site's typefaces. /admin still does not, and knowingly — it
   writes its own <html> and <head> rather than using this layout, and its
   problem is a 233 kB bundle in front of a sign-in form, not its typography. */
const fontFaces = [
  {
    family: 'Instrument Serif',
    style: 'normal',
    weight: '400',
    url: instrumentSerif,
  },
  {
    family: 'Instrument Serif',
    style: 'italic',
    weight: '400',
    url: instrumentSerifItalic,
  },
  {
    family: 'Inter Variable',
    style: 'normal',
    weight: '100 900',
    url: interVariable,
  },
  /* The handwriting accent, used in exactly two places: the top bar's monogram
     and the signature under the band quote. Registered here with the others so
     there is still only one stylesheet, but deliberately NOT preloaded below —
     see the note beside the preload links. */
  {
    family: 'Shadows Into Light Two',
    style: 'normal',
    weight: '400',
    url: shadowsIntoLightTwo,
  },
]
  .map(
    ({ family, style, weight, url }) =>
      `@font-face{font-family:"${family}";font-style:${style};font-weight:${weight};font-display:swap;src:url(${url}) format("woff2")}`,
  )
  .join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Before the icons, the card and the structured data, all of which are for
        somebody other than the reader. These four rules and the three files
        under them are the page's typography, and every page gets the same
        ones. */}
    <style is:inline set:html={fontFaces}></style>
    <!-- Three, not four. Shadows Into Light Two is registered above but stays
         off the critical path: it dresses two glyphs in the top-bar monogram,
         which paints at the first frame in the `cursive` fallback either way,
         and nothing on any page is laid out against that monogram's right edge.
         Preloading it would put 15 kB in front of the two Instrument Serif
         files that gate the real Largest Contentful Paint.

         All three are needed above the fold on every page. On the home page the
         wordmark is the LCP element (the full-bleed photo is disqualified — see
         the note in TopBar.astro) and it contains an italic ampersand, so the
         italic face is needed too; on /rsvp the italic dresses the monogram's
         own ampersand and the heading is Instrument Serif. Left to font
         matching, the italic is discovered a round trip late. -->
    <link rel="preload" as="font" type="font/woff2" href={instrumentSerif} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentSerifItalic} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interVariable} crossorigin />

    {/* Deliberately no <meta name="keywords">. No search engine has used it
        since the 2000s and it only ever advertises what you were hoping to
        rank for. */}

    {/* The browser chrome follows the paper, and inverts with the OS theme so
        the address bar does not glow white in a dark room. Both are the design
        tokens rather than new colours. */}
    <meta name="theme-color" content="#FBF8F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#241C18" media="(prefers-color-scheme: dark)" />

    {/* SVG first: it is the monogram at any size and carries its own dark-mode
        rule. The .ico is the fallback for browsers that still ask for one. */}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" type="image/x-icon" sizes="32x32" href={withBase('favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />

    {/* ---------------------------------------------------------------------
        Open Graph.

        This link gets forwarded through WhatsApp groups far more than it gets
        searched for, so for most guests these five tags ARE the site until
        they tap it. `og:image:width`/`height` are not optional decoration:
        without them WhatsApp cannot know the aspect ratio before it has
        fetched the file, and it falls back to the small square thumbnail
        rather than the large card.
    --------------------------------------------------------------------- */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Steeja &amp; Arjun" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      schema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schema)}
        />
      )
    }

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>

---
import Contact from '../components/Contact.astro';
import Countdown from '../components/Countdown.astro';
import Dresscode from '../components/Dresscode.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import FilmStrip from '../components/FilmStrip.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import Invitation from '../components/Invitation.astro';
import ImageBand from '../components/ImageBand.astro';
import LineArt from '../components/LineArt.astro';
import Rings from '../components/Rings.astro';
import RsvpCallout from '../components/RsvpCallout.astro';
import Schedule from '../components/Schedule.astro';
import Story from '../components/Story.astro';
import TopBar from '../components/TopBar.astro';
import Venue from '../components/Venue.astro';

// Derived 1920px master, not the 4672x7008 original — see prepare-media.mjs.
import lanternPhoto from '../assets/photos/gallery/EPK03505.jpg';
import {
  heroMedia,
  PHONE_MEDIA,
  PHONE_SIZES,
  WIDE_MEDIA,
  WIDE_SIZES,
} from '../lib/hero-media';
import Base from '../layouts/Base.astro';
import { absoluteUrl } from '../lib/paths';
import { weddingEventSchema } from '../lib/schema';
import '../styles/global.css';

const site = Astro.site ?? new URL('https://steejaarjun.github.io');

/* Written for a search result: the names, the date and the place, in that
   order, inside the ~60 characters Google will actually show. */
const title = 'Steeja & Arjun — 6 September 2026 | Kerala, India';
const description =
  "Steeja and Arjun are getting married on Sunday, 6 September 2026 in Kerala. Find the schedule, dress code, travel details — and let us know you're coming.";

/* Shorter and warmer than the search copy: this is what appears under the
   photograph in a chat thread, where the date is already on the card. */
const ogTitle = 'Steeja & Arjun · 6 September 2026';
const ogDescription = "We're getting married in Kerala. Come celebrate with us.";

/* The same card as og:image, and it has to stay the same card — this is the
   third place the filename appears (with Base.astro's `ogImage` default and
   OG_FILE in scripts/make-brand-assets.mjs). Nothing checks that the three
   agree; a stale name here does not break the page, it just tells Google a
   different image from the one every chat thread shows. */
const schema = weddingEventSchema(
  absoluteUrl('og-steeja-arjun-garden.jpg', site),
  absoluteUrl('', site),
);

/* Same call the hero makes, so the preload and the <picture> resolve to
   byte-identical URLs and the browser fetches the photo exactly once. */
const media = await heroMedia();

/* The @font-face block and the three font preloads used to be built here. They
   are in Base.astro now, because a page that did not include this file did not
   get the site's typefaces — which is what /rsvp and /admin had been doing. */
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  schema={schema}
>
  {/* Everything in this slot is specific to *this* page and cannot live in the
      layout: the two image preloads are computed from a build-time transform,
      the @font-face block is generated from the imported font URLs, and the
      reveal observer is the one script the public page ships. The generic meta
      — title, canonical, Open Graph, icons, structured data — is all in
      Base.astro. */}
  <Fragment slot="head">
    <!-- Preload the exact hero variant the <picture> below will choose, matched
         on media, type and sizes, so the two resolve to one request.
         Deliberately without fetchpriority="high": the photo is a 91-164 kB
         backdrop, while every word on the page — including the LCP element —
         waits on two 21 kB font files. Outranking the fonts with the photo
         pushes the text paint back by roughly a second on a throttled
         connection and buys nothing the visitor can see sooner. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media={PHONE_MEDIA}
      imagesrcset={media.phone.avif.srcset}
      imagesizes={PHONE_SIZES}
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media={WIDE_MEDIA}
      imagesrcset={media.wide.avif.srcset}
      imagesizes={WIDE_SIZES}
    />

    <!-- One observer for the three things on this page that animate as it is
         read — headings, images and the two drawn fronds — and the class that
         arms their hidden state. It runs here, in the head, so the hidden state
         is in effect before first paint; set up after DOMContentLoaded instead
         and a heading paints, vanishes, then fades back in. Bails out entirely
         under prefers-reduced-motion: no class, no observer, nothing to undo.
         Everything else on the page — body copy, list items, captions — carries
         no attribute and simply exists. -->
    {/* Astro strips this comment at build; the HTML comments around it ship,
        which is why the long version lives here and the script below carries
        almost none.

        `live` is flipped by the observer's first delivery of any kind — it
        reports every target it is handed on its first pass, intersecting or
        not — so in a working browser it is true within a frame or two.

        The timeout is a dead man's switch, and it exists because of a real
        failure rather than a hypothetical one. The armed state hides an image
        completely (`clip-path: inset(100%)`), so anything that stops the
        observer delivering does not degrade the animation, it deletes the
        photograph: an embedded or background view that never composites a
        frame, a tab that is snapshotted rather than rendered, a browser quirk.
        So the rule is now that nothing may hide content it cannot also reveal,
        and there are four independent ways this page keeps that promise. Three
        of them are below; the fourth is the `js` class itself, which is what the
        CSS gates on — no script, no hidden state, ever. */}
    <script is:inline>
      (function () {
        /* Synchronously, before a single section below is parsed. Every hidden
           start state in global.css hangs off this class, so an element can only
           ever start hidden on a page where scripting is confirmed to run. */
        document.documentElement.classList.add('js');

        if (
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          return;
        }

        function start() {
          var targets = document.querySelectorAll('[data-anim]');
          var i;

          function reveal(el) {
            el.classList.add('is-in');
          }

          /* Floor one: no observer, no animation, everything visible now. */
          if (!('IntersectionObserver' in window)) {
            for (i = 0; i < targets.length; i++) reveal(targets[i]);
            return;
          }

          var observer = new IntersectionObserver(
            function (entries) {
              for (var j = 0; j < entries.length; j++) {
                if (!entries[j].isIntersecting) continue;
                reveal(entries[j].target);
                observer.unobserve(entries[j].target);
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
          );

          for (i = 0; i < targets.length; i++) observer.observe(targets[i]);

          /* Floor two: anything already on screen is revealed right now, from
             its own geometry, rather than waiting for the observer's first
             delivery or for a scroll that may never come. */
          for (i = 0; i < targets.length; i++) {
            var box = targets[i].getBoundingClientRect();
            if (box.top < window.innerHeight && box.bottom > 0) {
              reveal(targets[i]);
              observer.unobserve(targets[i]);
            }
          }

          /* Floor three, and the one that ends this class of bug: 2.5s after
             load the gate itself comes off, which drops every hidden start
             state on the page at once.

             Deliberately the gate rather than a per-element `is-in` sweep.
             Adding `is-in` sets the end values but still asks a transition to
             travel to them, and a transition is one more thing that has to
             work — in a view that never composites a frame the computed value
             stays at `inset(100%)` forever even though the class is there,
             which is precisely how this bug kept surviving its own fixes.
             Removing the gate needs nothing to run: the start state stops
             existing and the pixels are simply there.

             The cost is real and worth naming: after this fires, nothing new
             animates on scroll. That is the trade — a static page that can be
             read beats an animated one that sometimes cannot. */
          window.addEventListener('load', function () {
            setTimeout(function () {
              document.documentElement.classList.remove('js');
            }, 2500);
          });
        }

        document.readyState !== 'loading'
          ? start()
          : document.addEventListener('DOMContentLoaded', start);
      })();
    </script>
  </Fragment>

  <TopBar />
    {/* The skip link's target. tabindex="-1" so the jump actually moves focus
        rather than only the scroll position — <main> is not focusable
        otherwise, and the next Tab would return to the top of the page. */}
    <main id="main" tabindex="-1">
      <Hero />
      {/* Directly after the hero and nowhere else: it pulls itself up over the
          photograph with a negative margin, so the two are only layered while
          they are adjacent. */}
      <Invitation />
      <Countdown />
      {/* The last thing between the card and Our Story, so the rings have
          closed before that heading is reached. */}
      <Rings />
      <Story />

      {/* Was a single tall band of the lantern frame. The black and white
          photographs were never going to work one at a time on a warm paper
          shell — as a strip on ink they are a set, and the band that used to
          sit here has moved down to close the Schedule instead. */}
      <FilmStrip />

      <Schedule />

      {/* The one full-width photograph left on the page, and it is pacing
          rather than content — it carries the single line addressed to the
          reader. A direct child of <main>, which sets no width, so it is edge
          to edge without a breakout hack.

          Every crop is decided here. 21:9 loses the top of the lantern and that
          is the right trade on a wide screen — the couple are lower right and
          the light is what the frame is about. Below 900px the same slice would
          be a hundred pixels tall, so it becomes 4:5 and keeps both. */}
      <ImageBand
        image={lanternPhoto}
        alt="Black and white: a street lamp burning above a narrow lane at night, with Steeja and Arjun standing close together beneath it, foreheads almost touching."
        quote="We're so grateful to celebrate this unforgettable day with you."
        attribution="Steeja & Arjun"
        ratio="21 / 9"
        ratioNarrow="4 / 5"
        focalPoint="62% 58%"
      />

      <Venue />
      <LineArt />
      <Dresscode />

      {/* The embrace frame used to sit here as a short band and read as an
          empty rectangle — it is exposed for one lamp and is nearly black. It
          now does the job that darkness is actually good for: it is the ground
          under the Dress code header, above. */}
      <Gallery />
      <Faq />

      {/* Second to last, deliberately. "One last thing" only reads as one last
          thing if everything a guest needs in order to answer — the times, the
          venues, what to wear, the questions they were going to ask anyway —
          is already behind them. And the section immediately after it is the
          four brothers, which is both the fallback when there is no JavaScript
          and the person to call if an answer has to change. */}
      <RsvpCallout />

      <LineArt flip />
      <Contact />
  </main>
  {/* Outside <main>: it is the page's footer, not part of its main content. */}
  <Footer />
</Base>

---
/**
 * TEMPORARY — see scripts/og-layout-experiment.mjs for what this is testing and
 * how to read the result. Delete this page, its image and the sitemap exclusion
 * in astro.config.mjs once the question is settled.
 *
 * Carries `noindex` and is excluded from the sitemap. It is reachable by anyone
 * who guesses the URL, which is why it says what it is on the page rather than
 * looking like a broken part of the wedding site.
 */
import Base from '../layouts/Base.astro';

const title = 'Preview layout test — 1000x1414';
const description =
  'Temporary page used to test which link preview layout WhatsApp chooses for a given og:image shape. Not part of the wedding site.';
---

<Base
  title={title}
  description={description}
  path="og-test-tall"
  ogImage="og-test-tall.jpg"
  ogImageAlt="A test card labelled 1000x1414, used to check which preview layout WhatsApp chooses."
  ogImageWidth={1000}
  ogImageHeight={1414}
  noindex
>
  <main style="font-family: system-ui; max-width: 34rem; margin: 4rem auto; padding: 0 1.5rem; line-height: 1.6;">
    <h1>Preview layout test — 1000x1414</h1>
    <p>
      This page exists to test which link preview layout WhatsApp chooses for an
      og:image of this shape. It is not part of Steeja and Arjun's wedding site.
    </p>
    <p><a href="/">Go to the wedding site</a></p>
  </main>
</Base>
